  .field small { color: var(--sl-color-gray-3); font-weight: 500; }
  input,select { box-sizing: border-box; width: 100%; min-height: 44px; padding: 10px 12px; border: 1px solid var(--sl-color-gray-5); border-radius: 10px; background: var(--sl-color-bg); color: var(--sl-color-text); font: inherit; }
  input:focus,select:focus { outline: 2px solid color-mix(in srgb,var(--sl-color-accent) 45%,transparent); outline-offset: 1px; }
  .result-panel { margin-top: 16px; padding: 16px; border: 1px solid var(--sl-color-gray-5); border-radius: 14px; background: var(--sl-color-bg); line-height: 1.55; }
  .muted-panel { color: var(--sl-color-gray-3); }
  .ok-panel { border-color: color-mix(in srgb,#3f8f5a 35%,var(--sl-color-gray-5)); }
  .warning-panel { border-color: color-mix(in srgb,#c78b2b 45%,var(--sl-color-gray-5)); }
  .danger-panel { border-color: color-mix(in srgb,#bd4a4a 55%,var(--sl-color-gray-5)); }
  .compact-panel { margin-top: 0; min-height: 44px; display: grid; align-content: center; }
  .compact-panel span { color: var(--sl-color-gray-3); font-size: .85rem; }
  .result-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14px; }
  .result-grid div { min-width: 0; }
  .result-grid span,.result-grid small { display: block; color: var(--sl-color-gray-3); font-size: .78rem; }
  .result-grid strong { display: block; margin-top: 2px; font-size: 1rem; overflow-wrap: anywhere; }
  .result-note { margin: 12px 0 0; color: var(--sl-color-gray-3); font-size: .84rem; line-height: 1.55; }
  .checklist-group { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px 18px; margin: 0; padding: 16px; border: 1px solid var(--sl-color-gray-5); border-radius: 14px; }
  .checklist-group legend { padding: 0 6px; font-size: .86rem; font-weight: 750; color: var(--sl-color-gray-2); }
  .checklist-group label { display: flex; gap: 10px; align-items: flex-start; color: var(--sl-color-gray-2); font-size: .86rem; line-height: 1.4; }
