  .med-row.done { opacity: .78; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .84rem; }
  th,td { padding: 10px 9px; border-bottom: 1px solid var(--sl-color-gray-6); text-align: left; vertical-align: top; }
  th { color: var(--sl-color-gray-2); font-size: .78rem; }
  td { color: var(--sl-color-gray-2); }
  .care-panel ul { margin: 0; padding-left: 20px; color: var(--sl-color-gray-2); }
  .care-panel li { margin: 6px 0; font-size: .86rem; line-height: 1.45; }
  .source-list { display: grid; gap: 10px; }
  .source-list a { color: var(--sl-color-accent-high); font-size: .84rem; line-height: 1.45; text-decoration: none; }
  .source-list a:hover { text-decoration: underline; }
  .disclaimer { display: grid; gap: 5px; margin-top: 18px; padding: 15px 17px; border: 1px solid var(--sl-color-gray-5); border-radius: 14px; color: var(--sl-color-gray-2); font-size: .83rem; line-height: 1.55; }
  .empty-state { padding: 18px; border: 1px dashed var(--sl-color-gray-5); border-radius: 14px; color: var(--sl-color-gray-2); }
  .empty-state span { display: block; margin-top: 4px; color: var(--sl-color-gray-3); font-size: .84rem; }
  @media (max-width: 980px) { .field-grid-4,.plan-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .result-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 760px) { .form-section,.results-section,.sources-section { padding: 18px; } .field-grid-3,.field-grid-4,.result-grid,.checklist-group,.plan-grid { grid-template-columns: 1fr; } .med-row { grid-template-columns: 1fr; gap: 6px; } .results-header { flex-direction: column; } .result-count { align-self: flex-start; } }
</style>
