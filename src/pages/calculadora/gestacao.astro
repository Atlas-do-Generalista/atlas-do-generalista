  .alert-score { display: flex; align-items: baseline; gap: 10px; margin-bottom: 8px; }
  .alert-score span { color: var(--sl-color-gray-3); font-size: .8rem; font-weight: 750; letter-spacing: .08em; }
  .alert-score strong { font-size: 1.8rem; line-height: 1; }
  .result-count { align-self: center; padding: 6px 10px; border: 1px solid var(--sl-color-gray-5); border-radius: 999px; color: var(--sl-color-gray-2); font-size: .8rem; white-space: nowrap; }
