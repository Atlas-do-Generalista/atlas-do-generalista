  .section-title { display: grid; grid-template-columns: auto 1fr; }
  .section-number { display: grid; width: 38px; height: 38px; place-items: center; border-radius: 10px; background: var(--sl-color-gray-6); color: var(--sl-color-accent-high); font-size: .72rem; font-weight: 800; letter-spacing: .04em; }
  .section-title h2,.results-header h2 { margin: 0; font-size: 1.35rem; }
  .section-title p { margin: 5px 0 0; color: var(--sl-color-gray-3); font-size: .9rem; line-height: 1.5; }
  .field-grid { display: grid; gap: 14px; }
  .field-grid-3 { grid-template-columns: repeat(3,minmax(0,1fr)); }
  .field-grid-4 { grid-template-columns: repeat(4,minmax(0,1fr)); }
  .field { display: grid; gap: 7px; min-width: 0; }
