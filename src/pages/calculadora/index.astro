---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const categorias = [
  {
    titulo: 'Condição atual',
    descricao:
      'Informe os dados clínicos disponíveis e descubra quais calculadoras podem ser executadas com essas informações.',
    icone: '🩺',
    href: `${base}/calculadora/condicao-atual/`,
  },
  {
    titulo: 'Quadro específico',
    descricao:
      'Acesse calculadoras e escores direcionados para síndromes, diagnósticos e situações clínicas específicas.',
    icone: '📋',
    href: `${base}/calculadora/quadro-especifico/`,
  },
  {
    titulo: 'Gestação',
    descricao:
      'Ferramentas específicas para avaliação e cálculo em pacientes gestantes.',
    icone: '🤰',
    href: `${base}/calculadora/gestacao/`,
  },
  {
    titulo: 'Criança',
    descricao:
      'Calculadoras, escores e ferramentas adaptadas à população pediátrica.',
    icone: '👶',
    href: `${base}/calculadora/crianca/`,
  },
];
---

<StarlightPage
  frontmatter={{
    title: 'Motor de Decisão Clínica',
    description:
      'Ferramentas de cálculo e apoio à decisão clínica do Atlas do Generalista.',
    tableOfContents: false,
  }}
>
  <main class="calculator-home">

    <a class="back-link" href={`${base}/`}>
      ← Voltar ao Atlas do Generalista
    </a>

    <header class="hero">
      <div class="eyebrow">ATLAS DO GENERALISTA</div>

      <h1>Motor de Decisão Clínica</h1>

      <p>
        Ferramentas de cálculo e apoio à decisão clínica organizadas a partir
        dos dados disponíveis do paciente.
      </p>
    </header>

    <section class="categories">

      <div class="section-header">
        <div class="eyebrow">COMECE POR AQUI</div>

        <h2>O que você precisa calcular?</h2>
      </div>

      <div class="category-grid">

        {
          categorias.map((categoria) => (
            <a
              class="category-card"
              href={categoria.href}
            >
              <div class="category-icon" aria-hidden="true">
                {categoria.icone}
              </div>

              <div class="category-body">
                <h3>{categoria.titulo}</h3>

                <p>
                  {categoria.descricao}
                </p>
              </div>

              <span
                class="category-arrow"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          ))
        }

      </div>

    </section>

    <aside class="disclaimer">
      <strong>Apoio à decisão clínica.</strong>

      <span>
        As ferramentas são auxiliares e não substituem julgamento clínico,
        protocolos institucionais ou referências primárias atualizadas.
      </span>
    </aside>

  </main>
</StarlightPage>

<style>
  .calculator-home {
    width: 100%;
    padding: 8px 0 32px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 32px;

    color: var(--sl-color-gray-2);
    text-decoration: none;

    font-size: 0.9rem;
  }

  .back-link:hover {
    color: var(--sl-color-white);
  }

  .hero {
    max-width: 820px;
    margin-bottom: 46px;
  }

  .eyebrow {
    margin-bottom: 10px;

    color: var(--sl-color-accent-high);

    font-size: 0.75rem;
    font-weight: 800;

    letter-spacing: 0.08em;
  }

  .hero h1 {
    margin: 0;

    font-size: clamp(2.3rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero p {
    max-width: 720px;

    margin: 18px 0 0;

    color: var(--sl-color-gray-2);

    font-size: 1.08rem;
    line-height: 1.7;
  }

  .section-header {
    margin-bottom: 20px;
  }

  .section-header h2 {
    margin: 0;

    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
  }

  .category-grid {
    display: grid;

    grid-template-columns: repeat(
      2,
      minmax(0, 1fr)
    );

    gap: 18px;
  }

  .category-card {
    display: grid;

    grid-template-columns: auto 1fr auto;

    gap: 16px;
    align-items: start;

    min-height: 150px;

    padding: 22px;

    border: 1px solid var(--sl-color-gray-5);
    border-radius: 16px;

    background: var(--sl-color-bg-nav);

    color: inherit;
    text-decoration: none;

    transition:
      transform 140ms ease,
      border-color 140ms ease,
      box-shadow 140ms ease;
  }

  .category-card:hover {
    transform: translateY(-2px);

    border-color: var(--sl-color-accent);

    box-shadow:
      0 12px 30px
      color-mix(
        in srgb,
        var(--sl-color-black) 12%,
        transparent
      );
  }

  .category-card:focus-visible {
    outline: 3px solid
      color-mix(
        in srgb,
        var(--sl-color-accent) 45%,
        transparent
      );

    outline-offset: 2px;
  }

  .category-icon {
    display: grid;

    width: 48px;
    height: 48px;

    place-items: center;

    border-radius: 12px;

    background: var(--sl-color-gray-6);

    font-size: 1.4rem;
  }

  .category-body h3 {
    margin: 2px 0 8px;

    font-size: 1.1rem;
  }

  .category-body p {
    margin: 0;

    color: var(--sl-color-gray-2);

    line-height: 1.55;
  }

  .category-arrow {
    align-self: center;

    color: var(--sl-color-gray-3);

    font-size: 1.2rem;
  }

  .category-card:hover .category-arrow {
    color: var(--sl-color-accent-high);
  }

  .disclaimer {
    display: grid;

    gap: 4px;

    margin-top: 26px;

    padding: 16px 18px;

    border: 1px solid var(--sl-color-gray-5);
    border-radius: 14px;

    color: var(--sl-color-gray-2);

    font-size: 0.85rem;
    line-height: 1.55;
  }

  .disclaimer strong {
    color: var(--sl-color-white);
  }

  @media (max-width: 760px) {
    .category-grid {
      grid-template-columns: 1fr;
    }

    .category-card {
      min-height: 0;
    }
  }
</style>
