---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<StarlightPage
  frontmatter={{
    title: 'Condição atual',
    description:
      'Coleta transversal e integrada de dados clínicos para alimentar automaticamente o Motor de Decisão Clínica.',
    tableOfContents: false,
  }}
>
  <main class="calculator-page">
    <div class="top-nav-bar">
      <a class="back-link" href={`${base}/calculadora/`}>
        ← Voltar ao Motor de Decisão Clínica
      </a>
      <button type="button" id="btn-clear-patient" class="btn-clear" title="Limpar todos os campos e reiniciar sessão do paciente">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18m-2 0v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6m3 0V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
        <span>Limpar dados / Novo paciente</span>
      </button>
    </div>

    <header class="page-header">
      <div class="eyebrow">MOTOR DE DECISÃO CLÍNICA</div>
      <h1>Condição atual</h1>
      <p>
        Forneça os dados clínicos uma única vez. O motor descobre, calcula e integra
        automaticamente em tempo real escores de gravidade, parâmetros hemodinâmicos,
        função renal, trocas gasosas, função hepática e índices compatíveis.
      </p>

      <nav class="quick-jump-nav" aria-label="Navegação rápida de seções">
        <span class="quick-jump-label">Ir para:</span>
        <div class="quick-jump-pills">
          <a href="#sec-geral" class="jump-pill">01. Geral</a>
          <a href="#sec-cronica" class="jump-pill">02. Saúde Crônica</a>
          <a href="#sec-ssvv" class="jump-pill">03. Sinais Vitais</a>
          <a href="#sec-neuro" class="jump-pill">04. Neurológico</a>
          <a href="#sec-lab" class="jump-pill">05. Laboratório</a>
          <a href="#sec-gaso" class="jump-pill">06. Gasometria</a>
          <a href="#sec-vaso" class="jump-pill">07. Vasoativos</a>
          <a href="#sec-sistemas" class="jump-pill">08. Sistemas / UTI</a>
          <a href="#sec-especificos" class="jump-pill">09. Específicos</a>
          <a href="#results-section" class="jump-pill jump-pill-results">Resultados (<span id="quick-count">0</span>) ↓</a>
        </div>
      </nav>
    </header>

    <form id="patient-form" class="clinical-form" autocomplete="off">
      <!-- SEÇÃO 01: DADOS GERAIS -->
      <section id="sec-geral" class="form-section">
        <div class="section-title">
          <span class="section-number">01</span>
          <div>
            <h2>Dados gerais e antropometria</h2>
            <p>Identificação biológica e medidas antropométricas do paciente.</p>
          </div>
        </div>

        <div class="field-grid field-grid-4">
          <label class="field">
            <span>Idade <small>(anos)</small></span>
            <input name="idade" type="number" min="0" max="130" step="1" inputmode="numeric" placeholder="Ex.: 67" />
          </label>

          <label class="field">
            <span>Sexo</span>
            <select name="sexo">
              <option value="">Não informado</option>
              <option value="feminino">Feminino</option>
              <option value="masculino">Masculino</option>
              <option value="outro">Outro / não aplicável</option>
            </select>
          </label>

          <label class="field">
            <span>Altura <small>(cm)</small></span>
            <input name="altura" type="number" min="30" max="250" step="1" inputmode="numeric" placeholder="Ex.: 170" />
          </label>

          <label class="field">
            <span>Peso <small>(kg)</small></span>
            <input name="peso" type="number" min="1" max="500" step="0.1" inputmode="decimal" placeholder="Ex.: 72" />
          </label>

          <label class="field">
            <span>Oxigênio suplementar atual</span>
            <select name="o2_suplementar">
              <option value="">Não informado</option>
              <option value="false">Não (ar ambiente)</option>
              <option value="true">Sim</option>
            </select>
          </label>

          <label class="field">
            <span>Consciência (NEWS2)</span>
            <select name="consciencia">
              <option value="">Não informado</option>
              <option value="alerta">Alerta</option>
              <option value="confusao">Confusão / alteração aguda (CVPU)</option>
              <option value="rebaixamento">Rebaixamento / não alerta</option>
            </select>
          </label>
        </div>
      </section>

      <!-- SEÇÃO 02: SAÚDE CRÔNICA / ADMISSÃO -->
      <section id="sec-cronica" class="form-section">
        <div class="section-title">
          <span class="section-number">02</span>
          <div>
            <h2>Saúde crônica e tipo de admissão</h2>
            <p>Comorbidades graves e contexto de admissão (APACHE II).</p>
          </div>
        </div>

        <div class="field-grid field-grid-3">
          <label class="field field-wide">
            <span>Insuficiência orgânica grave ou imunossupressão prévia</span>
            <select name="insuficiencia_organica_grave_imunossupressao">
              <option value="">Não informado</option>
              <option value="false">Não</option>
              <option value="true">Sim (cirrose biópsia/hipertensão portal, NYHA IV, DPOC/hipóxia crônica, diálise crônica, imunocomprometido)</option>
            </select>
          </label>

          <label class="field">
            <span>Tipo de admissão</span>
            <select name="tipo_admissao">
              <option value="">Não informado</option>
              <option value="clinica">Clínica / não operatório</option>
              <option value="pos_operatorio_eletivo">Pós-operatório eletivo</option>
              <option value="pos_operatorio_nao_eletivo">Pós-operatório não eletivo / urgência</option>
            </select>
          </label>
        </div>

        <p class="field-help">
          No APACHE II, pacientes com doença crônica grave ou imunocomprometidos recebem 5 pontos se a admissão for clínica ou pós-operatória de urgência, e 2 pontos se pós-operatória eletiva.
        </p>
      </section>

      <!-- SEÇÃO 03: SINAIS VITAIS -->
      <section id="sec-ssvv" class="form-section">
        <div class="section-title">
          <span class="section-number">03</span>
          <div>
            <h2>Sinais vitais e hemodinâmica</h2>
            <p>Parâmetros fisiológicos vitais da avaliação imediata.</p>
          </div>
        </div>

        <div class="field-grid field-grid-3">
          <label class="field">
            <span>Frequência cardíaca <small>(bpm)</small></span>
            <input name="fc" type="number" min="0" max="300" step="1" inputmode="numeric" placeholder="Ex.: 110" />
          </label>

          <label class="field">
            <span>Frequência respiratória <small>(irpm)</small></span>
            <input name="fr" type="number" min="0" max="100" step="1" inputmode="numeric" placeholder="Ex.: 28" />
          </label>

          <label class="field">
            <span>PAS <small>(mmHg)</small></span>
            <input name="pas" type="number" min="0" max="300" step="1" inputmode="numeric" placeholder="Ex.: 95" />
          </label>

          <label class="field">
            <span>PAD <small>(mmHg)</small></span>
            <input name="pad" type="number" min="0" max="200" step="1" inputmode="numeric" placeholder="Ex.: 60" />
          </label>

          <label class="field">
            <span>Temperatura <small>(°C)</small></span>
            <input name="temperatura" type="number" min="25" max="45" step="0.1" inputmode="decimal" placeholder="Ex.: 38,2" />
          </label>

          <label class="field">
            <span>Saturação O₂ <small>(SpO₂ %)</small></span>
            <input name="spo2" type="number" min="50" max="100" step="1" inputmode="numeric" placeholder="Ex.: 91" />
          </label>
        </div>
      </section>

      <!-- SEÇÃO 04: NEUROLÓGICO / GLASGOW -->
      <section id="sec-neuro" class="form-section">
        <div class="section-title">
          <span class="section-number">04</span>
          <div>
            <h2>Avaliação neurológica e Glasgow</h2>
            <p>Componentes da Escala de Coma de Glasgow com derivação padronizada.</p>
          </div>
        </div>

        <div class="field-grid field-grid-3">
          <label class="field">
            <span>Abertura ocular</span>
            <select name="glasgow_ocular">
              <option value="">Selecionar</option>
              <option value="4">4 — Espontânea</option>
              <option value="3">3 — Ao estímulo sonoro / voz</option>
              <option value="2">2 — Ao estímulo de pressão</option>
              <option value="1">1 — Nenhuma</option>
            </select>
          </label>

          <label class="field">
            <span>Resposta verbal</span>
            <select name="glasgow_verbal">
              <option value="">Selecionar</option>
              <option value="5">5 — Orientada</option>
              <option value="4">4 — Confusa</option>
              <option value="3">3 — Palavras inapropriadas</option>
              <option value="2">2 — Sons incompreensíveis</option>
              <option value="1">1 — Nenhuma</option>
            </select>
          </label>

          <label class="field">
            <span>Resposta motora</span>
            <select name="glasgow_motor">
              <option value="">Selecionar</option>
              <option value="6">6 — Obedece comandos</option>
              <option value="5">5 — Localiza estímulo</option>
              <option value="4">4 — Flexão normal (retirada)</option>
              <option value="3">3 — Flexão anormal (decorticação)</option>
              <option value="2">2 — Extensão anormal (descerebração)</option>
              <option value="1">1 — Nenhuma</option>
            </select>
          </label>
        </div>

        <div class="field-grid field-grid-3 neuro-extra">
          <label class="field">
            <span>Avaliação neurológica limitada?</span>
            <select name="glasgow_avaliacao_limitada">
              <option value="">Não informado</option>
              <option value="false">Não (paciente avaliável)</option>
              <option value="true">Sim (sedação / intubação)</option>
            </select>
          </label>

          <label class="field field-wide">
            <span>GCS prévio imediatamente antes da sedação/intubação <small>(se aplicável)</small></span>
            <input name="glasgow_pre_sedacao" type="number" min="3" max="15" step="1" inputmode="numeric" placeholder="Ex.: 12" />
          </label>
        </div>

        <div id="gcs-preview" class="computed-preview">
          Glasgow derivado: <strong>—</strong>
        </div>
      </section>

      <!-- SEÇÃO 05: LABORATÓRIO E BIOQUÍMICA -->
      <section id="sec-lab" class="form-section">
        <div class="section-title">
          <span class="section-number">05</span>
          <div>
            <h2>Laboratório, bioquímica e eletrólitos</h2>
            <p>Exames séricos para avaliação renal, metabólica, hidroeletrolítica e gravidade.</p>
          </div>
        </div>

        <div class="field-grid field-grid-4">
          <label class="field">
            <span>Creatinina sérica <small>(mg/dL)</small></span>
            <input name="creatinina" type="number" min="0" max="30" step="0.01" inputmode="decimal" placeholder="Ex.: 1,4" />
          </label>

          <label class="field">
            <span>Ureia sérica <small>(mg/dL)</small></span>
            <input name="ureia" type="number" min="0" max="500" step="0.1" inputmode="decimal" placeholder="Ex.: 48" />
          </label>

          <label class="field">
            <span>Sódio sérico <small>(mEq/L)</small></span>
            <input name="sodio" type="number" min="80" max="220" step="1" inputmode="numeric" placeholder="Ex.: 138" />
          </label>

          <label class="field">
            <span>Potássio sérico <small>(mEq/L)</small></span>
            <input name="potassio" type="number" min="1" max="10" step="0.1" inputmode="decimal" placeholder="Ex.: 4,2" />
          </label>

          <label class="field">
            <span>Cloro sérico <small>(mEq/L)</small></span>
            <input name="cloro" type="number" min="40" max="250" step="0.1" inputmode="decimal" placeholder="Ex.: 102" />
          </label>

          <label class="field">
            <span>Cálcio total <small>(mg/dL)</small></span>
            <input name="calcio" type="number" min="0" max="25" step="0.1" inputmode="decimal" placeholder="Ex.: 8,4" />
          </label>

          <label class="field">
            <span>Glicemia <small>(mg/dL)</small></span>
            <input name="glicemia" type="number" min="0" max="1500" step="1" inputmode="numeric" placeholder="Ex.: 130" />
          </label>

          <label class="field">
            <span>Albumina sérica <small>(g/dL)</small></span>
            <input name="albumina" type="number" min="0" max="8" step="0.1" inputmode="decimal" placeholder="Ex.: 3,2" />
          </label>

          <label class="field">
            <span>Bilirrubina total <small>(mg/dL)</small></span>
            <input name="bilirrubina" type="number" min="0" max="50" step="0.01" inputmode="decimal" placeholder="Ex.: 1,2" />
          </label>

          <label class="field">
            <span>INR</span>
            <input name="inr" type="number" min="0" max="20" step="0.01" inputmode="decimal" placeholder="Ex.: 1,2" />
          </label>

          <label class="field">
            <span>Hematócrito <small>(%)</small></span>
            <input name="hematocrito" type="number" min="0" max="80" step="0.1" inputmode="decimal" placeholder="Ex.: 40" />
          </label>

          <label class="field">
            <span>Hemoglobina <small>(g/dL)</small></span>
            <input name="hemoglobina" type="number" min="0" max="30" step="0.1" inputmode="decimal" placeholder="Ex.: 13,5" />
          </label>

          <label class="field">
            <span>Leucócitos <small>(×10³/µL)</small></span>
            <input name="leucocitos" type="number" min="0" max="200" step="0.1" inputmode="decimal" placeholder="Ex.: 9,8" />
          </label>

          <label class="field">
            <span>Plaquetas <small>(×10³/µL)</small></span>
            <input name="plaquetas" type="number" min="0" max="2000" step="1" inputmode="numeric" placeholder="Ex.: 220" />
          </label>

          <label class="field">
            <span>AST / TGO <small>(U/L)</small></span>
            <input name="ast" type="number" min="0" max="10000" step="1" inputmode="numeric" placeholder="Ex.: 32" />
          </label>

          <label class="field">
            <span>ALT / TGP <small>(U/L)</small></span>
            <input name="alt" type="number" min="0" max="10000" step="1" inputmode="numeric" placeholder="Ex.: 28" />
          </label>

          <label class="field">
            <span>Fosfatase alcalina <small>(U/L)</small></span>
            <input name="fosfatase_alcalina" type="number" min="0" max="5000" step="1" inputmode="numeric" placeholder="Ex.: 110" />
          </label>

          <label class="field">
            <span>GGT <small>(U/L)</small></span>
            <input name="ggt" type="number" min="0" max="5000" step="1" inputmode="numeric" placeholder="Ex.: 45" />
          </label>
        </div>
      </section>

      <!-- SEÇÃO 06: GASOMETRIA ARTERIAL -->
      <section id="sec-gaso" class="form-section">
        <div class="section-title">
          <span class="section-number">06</span>
          <div>
            <h2>Gasometria arterial e oxigenação</h2>
            <p>Parâmetros de equilíbrio ácido-base (Harrison 21ª Ed.), oxigenação e perfusão.</p>
          </div>
        </div>

        <div class="field-grid field-grid-4">
          <label class="field">
            <span>pH</span>
            <input name="ph" type="number" min="6.5" max="8.0" step="0.01" inputmode="decimal" placeholder="Ex.: 7,35" />
          </label>

          <label class="field">
            <span>PaCO₂ <small>(mmHg)</small></span>
            <input name="paco2" type="number" min="10" max="150" step="1" inputmode="numeric" placeholder="Ex.: 40" />
          </label>

          <label class="field">
            <span>PaO₂ <small>(mmHg)</small></span>
            <input name="pao2" type="number" min="20" max="700" step="1" inputmode="numeric" placeholder="Ex.: 85" />
          </label>

          <label class="field">
            <span>HCO₃⁻ <small>(mEq/L)</small></span>
            <input name="hco3" type="number" min="0" max="60" step="0.1" inputmode="decimal" placeholder="Ex.: 24" />
          </label>

          <label class="field">
            <span>Excesso de base <small>(mEq/L)</small></span>
            <input name="excesso_base" type="number" min="-40" max="40" step="0.1" inputmode="decimal" placeholder="Ex.: -2" />
          </label>

          <label class="field">
            <span>Lactato sérico <small>(mmol/L)</small></span>
            <input name="lactato" type="number" min="0" max="30" step="0.1" inputmode="decimal" placeholder="Ex.: 1,8" />
          </label>

          <label class="field">
            <span>SaO₂ gasometria <small>(%)</small></span>
            <input name="saturacao_gasometria" type="number" min="0" max="100" step="0.1" inputmode="decimal" placeholder="Ex.: 96" />
          </label>

          <label class="field">
            <span>FiO₂ <small>(%)</small></span>
            <input name="fio2_percent" type="number" min="21" max="100" step="1" inputmode="numeric" placeholder="Ex.: 21" />
          </label>

          <label class="field field-wide">
            <span>Gradiente A–aDO₂ informado <small>(mmHg; opcional/calculado automaticamente se idade e PaO₂ preenchidos)</small></span>
            <input name="aado2" type="number" min="0" max="800" step="1" inputmode="numeric" placeholder="Ex.: 15" />
          </label>
        </div>

        <p class="field-help">
          Quando o oxigênio suplementar for "Não", o sistema assume FiO₂ de 21% (ar ambiente).
          Com eletrólitos (sódio, cloro, bicarbonato e albumina), o motor analisa automaticamente o distúrbio primário, a compensação de Winter, distúrbios mistos (Tabelas 58-1/58-2) e o Delta Ratio.
        </p>
      </section>

      <!-- SEÇÃO 07: DROGAS VASOATIVAS -->
      <section id="sec-vaso" class="form-section">
        <div class="section-title">
          <span class="section-number">07</span>
          <div>
            <h2>Drogas vasoativas e inotrópicos</h2>
            <p>Suporte hemodinâmico farmacológico (SOFA-2).</p>
          </div>
        </div>

        <div class="field-grid field-grid-3">
          <label class="field">
            <span>Uso atual de drogas vasoativas</span>
            <select name="vasoativos_em_uso" id="vasoativos-em-uso">
              <option value="">Não informado</option>
              <option value="false">Não</option>
              <option value="true">Sim</option>
            </select>
          </label>

          <label class="field">
            <span>Infusão contínua há ≥1 hora?</span>
            <select name="vasoativos_continuos_1h">
              <option value="">Não informado</option>
              <option value="false">Não</option>
              <option value="true">Sim</option>
            </select>
          </label>
        </div>

        <div id="vasoactive-extra" class="conditional-panel" hidden>
          <div class="conditional-title">Doses atuais das infusões vasoativas</div>

          <div class="field-grid field-grid-4">
            <label class="field">
              <span>Noradrenalina <small>(µg/kg/min)</small></span>
              <input name="norepinefrina" type="number" min="0" max="5" step="0.01" inputmode="decimal" placeholder="Ex.: 0,10" />
            </label>

            <label class="field">
              <span>Adrenalina <small>(µg/kg/min)</small></span>
              <input name="epinefrina" type="number" min="0" max="5" step="0.01" inputmode="decimal" placeholder="Ex.: 0" />
            </label>

            <label class="field">
              <span>Dopamina <small>(µg/kg/min)</small></span>
              <input name="dopamina" type="number" min="0" max="100" step="0.1" inputmode="decimal" placeholder="Ex.: 5" />
            </label>

            <label class="field">
              <span>Vasopressina <small>(U/min)</small></span>
              <input name="vasopressina" type="number" min="0" max="0.1" step="0.01" inputmode="decimal" placeholder="Ex.: 0,03" />
            </label>

            <label class="field">
              <span>Dobutamina <small>(µg/kg/min)</small></span>
              <input name="dobutamina" type="number" min="0" max="100" step="0.1" inputmode="decimal" placeholder="Ex.: 5" />
            </label>

            <label class="field">
              <span>Milrinona <small>(µg/kg/min)</small></span>
              <input name="milrinona" type="number" min="0" max="1" step="0.01" inputmode="decimal" placeholder="Ex.: 0,2" />
            </label>

            <label class="field">
              <span>Nitroprussiato <small>(µg/kg/min)</small></span>
              <input name="nitroprussiato" type="number" min="0" max="20" step="0.1" inputmode="decimal" placeholder="Ex.: 0,5" />
            </label>

            <label class="field">
              <span>Nitroglicerina <small>(µg/kg/min)</small></span>
              <input name="nitroglicerina" type="number" min="0" max="20" step="0.1" inputmode="decimal" placeholder="Ex.: 0,5" />
            </label>
          </div>
        </div>
      </section>

      <!-- SEÇÃO 08: SISTEMAS / UTI -->
      <section id="sec-sistemas" class="form-section">
        <div class="section-title">
          <span class="section-number">08</span>
          <div>
            <h2>Suporte avançado e disfunção orgânica</h2>
            <p>Variáveis especializadas de suporte de UTI (SOFA-2 e APACHE II).</p>
          </div>
        </div>

        <div class="systems-grid">
          <div class="system-block">
            <h3>Respiratório</h3>
            <label class="field">
              <span>Suporte ventilatório atual</span>
              <select name="suporte_ventilatorio_tipo">
                <option value="">Não informado</option>
                <option value="nenhum">Nenhum / ar ambiente ou cânula comum</option>
                <option value="alto_fluxo">Cateter nasal de alto fluxo (CNAF)</option>
                <option value="cpap">CPAP</option>
                <option value="bipap_niv">BiPAP / VNI</option>
                <option value="ventilacao_mecanica_invasiva">Ventilação mecânica invasiva (IOT/Traqueostomia)</option>
                <option value="ventilacao_domestica">Ventilação mecânica domiciliar</option>
              </select>
            </label>

            <label class="field">
              <span>ECMO com indicação respiratória?</span>
              <select name="ecmo_respiratorio">
                <option value="">Não informado</option>
                <option value="false">Não</option>
                <option value="true">Sim (VV-ECMO)</option>
              </select>
            </label>
          </div>

          <div class="system-block">
            <h3>Cardiovascular</h3>
            <label class="field">
              <span>Suporte mecânico cardiovascular (ex.: balão intra-aórtico, Impella)?</span>
              <select name="suporte_mecanico_cardiovascular">
                <option value="">Não informado</option>
                <option value="false">Não</option>
                <option value="true">Sim</option>
              </select>
            </label>

            <label class="field">
              <span>ECMO com indicação cardiovascular (VA-ECMO)?</span>
              <select name="ecmo_cardiovascular">
                <option value="">Não informado</option>
                <option value="false">Não</option>
                <option value="true">Sim</option>
              </select>
            </label>
          </div>

