<script>
  import type { ContextoPaciente, ValorClinico, DominioClinico, TipoMetrica, NivelGravidade } from '../../lib/calc-engine/types';
  import { getPatientSession, updateGeneralData, clearPatientSession } from '../../lib/patient-state';
  import { deriveGlasgow } from '../../lib/clinical-assessment';
  import { composeClinicalSummary, type ItemCalculado } from '../../lib/clinical-summary';

  type Campo = HTMLInputElement | HTMLSelectElement;

  let inicializado = false;
  let activeDomain = 'todos';
  let cachedCalculatedItems: ItemCalculado[] = [];
  let cachedSummaryText = '';

  function parseBoolean(value: string): boolean | null {
    if (value === 'true') return true;
    if (value === 'false') return false;
    return null;
  }

  function parseField(field: Campo): ValorClinico {
    const value = field.value.trim();
    if (value === '') return null;

    if (field instanceof HTMLInputElement && field.type === 'number') {
      const n = Number(value.replace(',', '.'));
      return Number.isFinite(n) ? n : null;
    }

    const boolean = parseBoolean(value);
    if (boolean !== null) return boolean;

    return value;
  }

  function collectData(form: HTMLFormElement): ContextoPaciente {
    const data: ContextoPaciente = {};

    form.querySelectorAll<Campo>('input, select').forEach((field) => {
      const value = parseField(field);
      if (value !== null) data[field.name] = value;
    });

    // 1. Derivação formal do Glasgow via Clinical Assessment
    const glasgowResult = deriveGlasgow({
      ocular: data.glasgow_ocular,
      verbal: data.glasgow_verbal,
      motor: data.glasgow_motor,
      avaliacaoLimitada: data.glasgow_avaliacao_limitada,
      preSedacao: data.glasgow_pre_sedacao,
    });

    if (glasgowResult.gcs !== null) {
      data.gcs = glasgowResult.gcs;
    }
    if (typeof data.glasgow_ocular === 'string') data.glasgow_ocular = Number(data.glasgow_ocular);
    if (typeof data.glasgow_verbal === 'string') data.glasgow_verbal = Number(data.glasgow_verbal);
    if (typeof data.glasgow_motor === 'string') data.glasgow_motor = Number(data.glasgow_motor);

    // 2. Resolução de FiO2 e suporte ventilatório
    const tipoSuporte = data.suporte_ventilatorio_tipo;
    if (typeof tipoSuporte === 'string' && tipoSuporte !== '' && tipoSuporte !== 'nenhum') {
      data.suporte_ventilatorio_avancado = true;
    } else if (tipoSuporte === 'nenhum') {
      data.suporte_ventilatorio_avancado = false;
    }

    const o2 = data.o2_suplementar;
    const fio2Percent = data.fio2_percent;
    if (typeof fio2Percent === 'number') {
      data.fio2 = fio2Percent / 100;
    } else if (o2 === false) {
      data.fio2 = 0.21;
    }

    // 3. Suporte vasoativo
    const vasoativoOn = data.vasoativos_em_uso;
    const continuous = data.vasoativos_continuos_1h;

    if (vasoativoOn !== true || continuous === false) {
      data.norepinefrina = 0;
      data.epinefrina = 0;
      data.dopamina = 0;
      data.vasopressina = 0;
      data.dobutamina = 0;
      data.milrinona = 0;
      data.nitroprussiato = 0;
      data.nitroglicerina = 0;
    }

    const otherSOFA =
      Number(data.vasopressina ?? 0) > 0 ||
      Number(data.dobutamina ?? 0) > 0 ||
      Number(data.milrinona ?? 0) > 0;

    data.sofa2_outro_vasoativo = otherSOFA;
    data.sofa2_delirium_tratamento = data.delirium_tratamento;
    data.sofa2_norepinefrina = data.norepinefrina;
    data.sofa2_epinefrina = data.epinefrina;
    data.sofa2_suporte_ventilatorio = data.suporte_ventilatorio_avancado;
    data.sofa2_ecmo = data.ecmo_respiratorio;
    data.sofa2_suporte_mecanico_cardiovascular = data.suporte_mecanico_cardiovascular;
    data.sofa2_diurese_ml_hora =
      typeof data.diurese_ml === 'number' && typeof data.diurese_horas === 'number' && data.diurese_horas > 0
        ? data.diurese_ml / data.diurese_horas
        : undefined;
    data.sofa2_diurese_horas = data.diurese_horas;
    data.sofa2_trs = data.terapia_renal_substitutiva;

    return data;
  }

  function escapeHtml(value: unknown): string {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function formatNumber(value: unknown, digits = 1): string {
    if (typeof value !== 'number' || !Number.isFinite(value)) return String(value ?? '');
    return new Intl.NumberFormat('pt-BR', {
      minimumFractionDigits: digits,
      maximumFractionDigits: digits,
    }).format(value);
  }

  function formatClinicalValue(value: unknown): string {
    if (value === true) return 'Sim';
    if (value === false) return 'Não';
    if (typeof value === 'number') return formatNumber(value, Number.isInteger(value) ? 0 : 2);
    if (value === null || value === undefined || value === '') return '—';
    return String(value);
  }

  function toggleVasoactivePanel(form: HTMLFormElement): void {
    const select = form.querySelector<HTMLSelectElement>('#vasoativos-em-uso');
    const panel = form.querySelector<HTMLElement>('#vasoactive-extra');
    if (!select || !panel) return;
    panel.hidden = select.value !== 'true';
  }

  function updateGcsPreview(form: HTMLFormElement): void {
    const preview = form.querySelector<HTMLElement>('#gcs-preview');
    if (!preview) return;

    const ocular = form.querySelector<HTMLSelectElement>('select[name="glasgow_ocular"]')?.value;
    const verbal = form.querySelector<HTMLSelectElement>('select[name="glasgow_verbal"]')?.value;
    const motor = form.querySelector<HTMLSelectElement>('select[name="glasgow_motor"]')?.value;
    const limitado = form.querySelector<HTMLSelectElement>('select[name="glasgow_avaliacao_limitada"]')?.value;
    const pre = form.querySelector<HTMLInputElement>('input[name="glasgow_pre_sedacao"]')?.value;

    const res = deriveGlasgow({
      ocular,
      verbal,
      motor,
      avaliacaoLimitada: limitado,
      preSedacao: pre,
    });

    preview.innerHTML = `Glasgow derivado: <strong>${escapeHtml(res.rotuloFormatado.replace('Glasgow: ', ''))}</strong>`;
  }

  function populateFormFromSession(form: HTMLFormElement): void {
    try {
      const session = getPatientSession();
      if (!session || !session.general) return;

      const entries = Object.entries(session.general);
      for (const [key, val] of entries) {
        if (val === null || val === undefined) continue;
        const field = form.querySelector<Campo>(`[name="${key}"]`);
        if (field) {
          field.value = String(val);
        }
      }
    } catch (err) {
      console.warn('[Atlas] Erro ao recuperar sessão do paciente:', err);
    }
  }

  function getDomainLabel(domain?: DominioClinico | string): string {
    switch (domain) {
      case 'gravidade': return 'Gravidade & Deterioração';
      case 'cardiovascular': return 'Cardiovascular & Hemodinâmica';
      case 'gasometria': return 'Gasometria & Ácido-Base';
      case 'renal': return 'Função Renal';
      case 'hepatica': return 'Função Hepática';
      case 'metabolismo': return 'Metabolismo & Eletrólitos';
      case 'antropometria': return 'Antropometria';
      case 'risco': return 'Risco & Profilaxia';
      case 'neurologico': return 'Neurológico';
      default: return 'Avaliação Geral';
    }
  }

  function getTipoMetricaBadge(tipo?: TipoMetrica): string {
    switch (tipo) {
      case 'escore': return '<span class="badge-type badge-escore">Escore</span>';
      case 'medida_calculada': return '<span class="badge-type badge-medida">Medida Calculada</span>';
      case 'classificacao': return '<span class="badge-type badge-classificacao">Classificação</span>';
      case 'indice': return '<span class="badge-type badge-indice">Índice</span>';
      case 'regra_decisao': return '<span class="badge-type badge-regra">Regra de Decisão</span>';
      case 'criterio_diagnostico': return '<span class="badge-type badge-criterio">Critério</span>';
      default: return '';
    }
  }

  function getGravityBadge(gravidade?: NivelGravidade): string {
    switch (gravidade) {
      case 'critico': return '<span class="badge-gravity badge-critico">Crítico</span>';
      case 'alerta': return '<span class="badge-gravity badge-alerta">Alerta</span>';
      case 'atencao': return '<span class="badge-gravity badge-atencao">Atenção</span>';
      case 'normal': return '<span class="badge-gravity badge-normal">Normal</span>';
      default: return '';
    }
  }

  function mapCalcToDomain(calc: { id: string; dominioClinico?: DominioClinico; categoria: string }): string {
    if (calc.dominioClinico) return calc.dominioClinico;
    const cat = calc.categoria.toLowerCase();
    if (cat.includes('antropometria')) return 'antropometria';
    if (cat.includes('gravidade')) return 'gravidade';
    if (cat.includes('sinais vitais') || cat.includes('hemodinamica')) return 'cardiovascular';
    if (cat.includes('renal')) return 'renal';
    if (cat.includes('hepatica')) return 'hepatica';
    if (cat.includes('gasometria')) return 'gasometria';
    if (cat.includes('metabolico') || cat.includes('laboratorio')) return 'metabolismo';
    if (cat.includes('risco') || cat.includes('neurologicas')) return 'risco';
    return 'outros';
  }

  function renderFilteredCards(container: HTMLElement, items: ItemCalculado[], filter: string): void {
    container.innerHTML = '';

    const filtered = filter === 'todos'
      ? items
      : items.filter((item) => mapCalcToDomain(item.calc) === filter);

    if (filtered.length === 0) {
      container.innerHTML = `
        <div class="empty-state">
          <strong>Nenhuma ferramenta neste domínio com os dados atuais.</strong>
          <span>Alterne o filtro ou preencha os parâmetros correspondentes.</span>
        </div>
      `;
      return;
    }

    filtered.forEach(({ calc, resultado }) => {
      const card = document.createElement('article');
      const gravidade = resultado.nivelGravidade ?? 'normal';
      card.className = `result-card card-gravity-${gravidade}`;
      card.dataset.domain = mapCalcToDomain(calc);

      const interpretacao = typeof calc.interpretar === 'function'
        ? (() => { try { return calc.interpretar(resultado); } catch { return ''; } })()
        : '';

      const detalhes = resultado.detalhamento ?? [];
      const avisos = resultado.avisos ?? [];

      const detalhesHtml = detalhes.length > 0
        ? `
          <details class="breakdown-details">
            <summary>Ver detalhamento do cálculo (${detalhes.length} itens)</summary>
            <div class="breakdown">
              ${detalhes.map((item) => `
                <div class="breakdown-row">
                  <div class="breakdown-label">${escapeHtml(item.descricao || item.campo)}</div>
                  <div class="breakdown-data">
                    <span class="breakdown-value">${escapeHtml(formatClinicalValue(item.valor))}</span>
                    ${typeof item.pontos === 'number'
                      ? `<span class="breakdown-points">${item.pontos} pt${item.pontos === 1 ? '' : 's'}</span>`
                      : ''}
                  </div>
                </div>
              `).join('')}
            </div>
          </details>
        `
        : '';

      const avisosHtml = avisos.length > 0
        ? `
          <div class="result-warnings">
            <strong>Salvaguardas Clínicas & Observações</strong>
            <ul>${avisos.map((a) => `<li>${escapeHtml(a)}</li>`).join('')}</ul>
          </div>
        `
        : '';

      const refHtml = calc.referencias && calc.referencias.length > 0
        ? `
          <div class="card-ref-footer">
            <span class="ref-title">Ref:</span>
            <span>${escapeHtml(calc.referencias[0].titulo)}</span>
          </div>
        `
        : '';

      card.innerHTML = `
        <div class="card-header-bar">
          <div class="card-tags">
            <span class="result-category">${escapeHtml(getDomainLabel(calc.dominioClinico ?? calc.categoria))}</span>
            ${getTipoMetricaBadge(calc.tipoMetrica)}
            ${getGravityBadge(resultado.nivelGravidade)}
          </div>
          <div class="result-value-box">
            <span class="result-value">${escapeHtml(formatClinicalValue(resultado.valor))}</span>
            ${resultado.unidade ? `<span class="result-unit">${escapeHtml(resultado.unidade)}</span>` : ''}
          </div>
        </div>

        <h3 class="card-title">${escapeHtml(calc.nome)}</h3>

        ${interpretacao ? `<p class="result-interpretation">${escapeHtml(interpretacao)}</p>` : ''}
        ${detalhesHtml}
        ${avisosHtml}
        ${refHtml}
      `;

      container.appendChild(card);
    });
  }

  function updateDomainCounts(items: ItemCalculado[]): void {
    const counts: Record<string, number> = {
      todos: items.length,
      gravidade: 0,
      cardiovascular: 0,
      gasometria: 0,
      renal: 0,
      hepatica: 0,
      metabolismo: 0,
      antropometria: 0,
      risco: 0,
    };

    items.forEach((item) => {
      const d = mapCalcToDomain(item.calc);
      if (counts[d] !== undefined) counts[d]++;
    });

    for (const [dom, num] of Object.entries(counts)) {
      const el = document.getElementById(`count-${dom}`);
      if (el) el.textContent = String(num);
    }
  }

  async function render(
    form: HTMLFormElement,
    resultsGrid: HTMLElement,
    resultCount: HTMLElement,
    quickCount: HTMLElement,
    summaryCard: HTMLElement,
  ): Promise<void> {
    const data = collectData(form);
    const hasAny = Object.keys(data).length > 0;

    // Atualiza preview de GCS
    updateGcsPreview(form);

    // Salva automaticamente no patient-state
    if (hasAny) {
      updateGeneralData(data);
    }

    if (!hasAny) {
      resultCount.textContent = 'Aguardando dados';
      quickCount.textContent = '0';
      summaryCard.hidden = true;
      cachedCalculatedItems = [];
      updateDomainCounts([]);
      resultsGrid.innerHTML = `
        <div class="empty-state">
          <strong>Comece preenchendo os dados do paciente.</strong>
          <span>Conforme as variáveis forem informadas, as ferramentas compatíveis aparecerão automaticamente aqui.</span>
        </div>
      `;
      return;
    }

    try {
      const [{ registry }, { calcularDisponiveis }] = await Promise.all([
        import('../../lib/calc-engine/registry'),
        import('../../lib/calc-engine/engine'),
      ]);

      const available = calcularDisponiveis(data, registry);
      const complete = available
        .filter((item): item is { status: 'ok'; calc: typeof item.calc; resultado: typeof item.resultado } => item.status === 'ok')
        .map((item) => ({ calc: item.calc, resultado: item.resultado }));

      const incomplete = available.filter((item) => item.status === 'incompleto');
      const errors = available.filter((item) => item.status === 'erro');

      cachedCalculatedItems = complete;

      resultCount.textContent = `${complete.length} ${complete.length === 1 ? 'ferramenta calculada' : 'ferramentas calculadas'}`;
      quickCount.textContent = String(complete.length);

      updateDomainCounts(complete);

      // Renderiza os cards conforme o filtro ativo
      renderFilteredCards(resultsGrid, complete, activeDomain);

      // Renderiza Síntese Clínica para Prontuário
      if (complete.length > 0) {
        summaryCard.hidden = false;
        const summary = composeClinicalSummary(data, complete);
        cachedSummaryText = summary.textoEvolucaoCorrida;

        const tokensBar = document.getElementById('summary-tokens-bar');
        if (tokensBar) {
          tokensBar.innerHTML = summary.linhaResumoScores
            ? `<strong>Resumo de Escores:</strong> ${escapeHtml(summary.linhaResumoScores)}`
            : '';
        }

        const paragraphsBox = document.getElementById('summary-paragraphs');
        if (paragraphsBox) {
          paragraphsBox.innerHTML = summary.paragrafos.map((p) => `
            <div class="summary-paragraph">
              <span class="summary-para-label">${escapeHtml(p.titulo)}:</span>
              <span class="summary-para-text">${escapeHtml(p.conteudo)}</span>
            </div>
          `).join('');
        }
      } else {
        summaryCard.hidden = true;
      }

      // Seção de incompletos
      const incompleteContainer = document.getElementById('incomplete-container');
      const incompleteSummary = document.getElementById('incomplete-summary');
      const incompleteList = document.getElementById('incomplete-list');

      if (incompleteContainer && incompleteSummary && incompleteList) {
        if (incomplete.length > 0) {
          incompleteContainer.hidden = false;
          incompleteSummary.textContent = `${incomplete.length} ferramenta${incomplete.length === 1 ? '' : 's'} aguardando dados adicionais`;
          incompleteList.innerHTML = incomplete.map(({ calc, faltando }) => `
            <div class="incomplete-item">
              <div class="incomplete-name">
                <strong>${escapeHtml(calc.nome)}</strong>
                <span class="category-pill">${escapeHtml(getDomainLabel(calc.dominioClinico ?? calc.categoria))}</span>
              </div>
              <div class="missing-pills">
                <span class="missing-label">Necessita:</span>
                ${faltando.map((f) => `<span class="missing-tag">${escapeHtml(f)}</span>`).join('')}
              </div>
            </div>
          `).join('');
        } else {
          incompleteContainer.hidden = true;
        }
      }

      // Seção de erros
      const errorsContainer = document.getElementById('errors-container');
      const errorsSummary = document.getElementById('errors-summary');
      const errorsList = document.getElementById('errors-list');

      if (errorsContainer && errorsSummary && errorsList) {
        if (errors.length > 0) {
          errorsContainer.hidden = false;
          errorsSummary.textContent = `${errors.length} ferramenta${errors.length === 1 ? '' : 's'} com parâmetros inválidos`;
          errorsList.innerHTML = errors.map(({ calc, erro }) => `
            <div class="incomplete-item error-item">
              <strong>${escapeHtml(calc.nome)}</strong>
              <span>${escapeHtml(erro)}</span>
            </div>
          `).join('');
        } else {
          errorsContainer.hidden = true;
        }
      }
    } catch (error) {
      console.error('[Atlas] Erro no processamento do motor:', error);
      resultCount.textContent = 'Erro';
      quickCount.textContent = '!';
      summaryCard.hidden = true;
      resultsGrid.innerHTML = `
        <div class="error-state">
          <strong>Falha ao processar o Motor de Decisão Clínica.</strong>
          <span>Consulte o console para detalhes do erro de execução.</span>
        </div>
      `;
    }
  }

  function iniciar(): void {
    if (inicializado) return;

    const form = document.querySelector<HTMLFormElement>('#patient-form');
    const resultsGrid = document.querySelector<HTMLElement>('#results');
    const resultCount = document.querySelector<HTMLElement>('#result-count');
    const quickCount = document.querySelector<HTMLElement>('#quick-count');
    const summaryCard = document.querySelector<HTMLElement>('#clinical-summary-card');
    const btnClear = document.querySelector<HTMLButtonElement>('#btn-clear-patient');
    const btnCopy = document.querySelector<HTMLButtonElement>('#btn-copy-summary');
    const copyText = document.querySelector<HTMLElement>('#copy-btn-text');

    if (!form || !resultsGrid || !resultCount || !quickCount || !summaryCard) return;

    inicializado = true;

    // 1. Hidratação da sessão anterior
    populateFormFromSession(form);
    toggleVasoactivePanel(form);
    updateGcsPreview(form);

    // 2. Ouvintes de eventos do formulário
    form.addEventListener('input', () => {
      updateGcsPreview(form);
      void render(form, resultsGrid, resultCount, quickCount, summaryCard);
    });

    form.addEventListener('change', () => {
      toggleVasoactivePanel(form);
      updateGcsPreview(form);
      void render(form, resultsGrid, resultCount, quickCount, summaryCard);
    });

    // 3. Ouvinte de filtros de domínio
    const tabs = document.querySelectorAll<HTMLButtonElement>('.domain-tab');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        activeDomain = tab.dataset.domain ?? 'todos';
        renderFilteredCards(resultsGrid, cachedCalculatedItems, activeDomain);
      });
    });

    // 4. Botão de limpar sessão do paciente
    if (btnClear) {
      btnClear.addEventListener('click', () => {
        if (confirm('Deseja realmente limpar todos os dados do paciente e reiniciar a sessão?')) {
          clearPatientSession();
          form.reset();
          toggleVasoactivePanel(form);
          updateGcsPreview(form);
          void render(form, resultsGrid, resultCount, quickCount, summaryCard);
        }
      });
    }

    // 5. Botão de copiar resumo clínico
    if (btnCopy && copyText) {
      btnCopy.addEventListener('click', async () => {
        if (!cachedSummaryText) return;
        try {
          await navigator.clipboard.writeText(cachedSummaryText);
          const original = copyText.textContent;
          copyText.textContent = 'Copiado! ✓';
          btnCopy.classList.add('copied');
          setTimeout(() => {
            copyText.textContent = original;
            btnCopy.classList.remove('copied');
          }, 2200);
        } catch {
          alert('Não foi possível copiar automaticamente para a área de transferência.');
        }
      });
    }

    // 6. Renderização inicial
    void render(form, resultsGrid, resultCount, quickCount, summaryCard);
  }

  document.addEventListener('astro:page-load', iniciar);

  if (document.readyState !== 'loading') {
    queueMicrotask(iniciar);
  } else {
    document.addEventListener('DOMContentLoaded', iniciar, { once: true });
  }
</script>

