---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { IDGKnowledgeRegistry } from '../../lib/idg/knowledge/registry';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const presentations = IDGKnowledgeRegistry.getAllPresentations();
---

<StarlightPage
  frontmatter={{
    title: 'Investigação Diagnóstica Guiada (IDG)',
    description:
      'Sistema estruturado de apoio à investigação diagnóstica e raciocínio clínico para emergência e medicina interna.',
    tableOfContents: false,
  }}
>
  <main class="idg-container">
    <!-- BARRA SUPERIOR DE PRIVACIDADE E NAVEGAÇÃO -->
    <div class="top-nav-bar">
      <a class="back-link" href={`${base}/calculadora/`}>
        ← Voltar ao Motor de Decisão Clínica
      </a>

      <div class="privacy-badge" title="Processamento 100% no navegador. Dados descartados ao fechar ou recarregar a página.">
        <span class="privacy-dot" aria-hidden="true"></span>
        <span>Privacidade Offline Estrita · Estado em Memória</span>
      </div>

      <button type="button" id="btn-reset-investigation" class="btn-clear" title="Descartar todos os dados e reiniciar">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18m-2 0v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6m3 0V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
          <line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>
        </svg>
        <span>Reiniciar Investigação</span>
      </button>
    </div>

    <!-- CABEÇALHO -->
    <header class="page-header">
      <div class="eyebrow">MOTOR DE DECISÃO CLÍNICA · SEGUNDA LINHA COGNITIVA</div>
      <h1>Investigação Diagnóstica Guiada (IDG)</h1>
      <p class="lead-quote">
        <em>"Medicina não é sobre estar certo. É sobre minimizar a chance de estar errado e, por consequência, acertar mais."</em>
      </p>
      <p class="lead-desc">
        Apoio estruturado à investigação beira-leito para o emergencista. Confronta suas hipóteses,
        rastreia condições potencialmente fatais esquecidas e orienta próximos passos discriminatórios
        sem viés de fechamento prematuro.
      </p>
    </header>

    <!-- ÁREA 4: SEGURANÇA DIAGNÓSTICA (ALERTAS CRÍTICOS IMEDIATOS) -->
    <section id="sec-safety-alerts" class="alerts-container" aria-live="assertive" style="display: none;">
      <div class="alerts-header">
        <span class="alert-icon">🚨</span>
        <h3>ALERTAS CRÍTICOS DE SEGURANÇA DIAGNÓSTICA</h3>
      </div>
      <div id="alerts-list" class="alerts-list"></div>
    </section>

    <!-- GRID PRINCIPAL DE TRABALHO -->
    <div class="workspace-grid">
      <!-- COLUNA DA ESQUERDA: APRESENTAÇÃO E INVESTIGAÇÃO GUIADA -->
      <div class="left-column">
        <!-- ÁREA 1: APRESENTAÇÃO CLÍNICA -->
        <section class="card-section">
          <div class="section-title">
            <span class="section-number">01</span>
            <div>
              <h2>Apresentação Clínica e Contexto</h2>
              <p>Selecione as queixas principais e registre a contextualização do caso.</p>
            </div>
          </div>

          <div class="field-block">
            <label class="field-label">Apresentações clínicas observadas:</label>
            <div class="presentations-chips">
              {
                presentations.map((p) => (
                  <button
                    type="button"
                    class="chip-button"
                    data-presentation-id={p.id}
                  >
                    <span class="chip-icon">{p.icon}</span>
                    <span class="chip-label">{p.label}</span>
                  </button>
                ))
              }
            </div>
            <p id="presentation-feedback" class="import-status-text" role="status" aria-live="polite">Inicializando interação das apresentações…</p>
          </div>

          <div class="field-block">
            <label for="txt-free-description" class="field-label">Descrição livre do caso (anamnese resumida / impressão inicial):</label>
            <textarea
              id="txt-free-description"
              class="clinical-textarea"
              rows="3"
              placeholder="Ex.: Paciente masculino 62 anos, hipertenso, com dor torácica retroesternal de início súbito após esforço moderado, irradiando para dorso..."
              aria-describedby="free-description-help"
            ></textarea>
            <small id="free-description-help" class="field-help">O texto livre complementa a história e aciona regras locais específicas quando reconhecidas; registre também os achados discriminatórios nos campos estruturados. Não há interpretação generativa de linguagem natural.</small>
          </div>

          <div class="field-block">
            <label for="txt-initial-hypotheses" class="field-label">
              Suas hipóteses diagnósticas iniciais (separadas por vírgula):
              <small class="field-help">Hipóteses cadastradas serão incorporadas à avaliação; termos sem correspondência na base não recebem pontuação nem avaliação automatizada.</small>
            </label>
            <input
              id="txt-initial-hypotheses"
              type="text"
              class="clinical-input"
              placeholder="Ex.: Síndrome coronariana aguda, espasmo esofágico"
            />
          </div>

          <div class="integration-toolbar">
            <button type="button" id="btn-import-context" class="btn-secondary" title="Lê em memória dados já digitados no formulário de Condição Atual">
              📥 Importar dados do ContextoPaciente
            </button>
            <span id="import-status-msg" class="import-status-text"></span>
          </div>
        </section>

        <!-- ÁREA 3: INVESTIGAÇÃO ADAPTATIVA (PERGUNTAS DISCRIMINATÓRIAS) -->
        <section class="card-section">
          <div class="section-title">
            <span class="section-number">03</span>
            <div>
              <h2>Investigação Guiada Adaptativa</h2>
              <p>Perguntas priorizadas pelo poder de discriminar entre as hipóteses ativas.</p>
            </div>
          </div>

          <div id="questions-container" class="questions-stream">
            <div class="empty-hint">Selecione ao menos uma apresentação clínica acima para iniciar as perguntas direcionadas.</div>
          </div>
        </section>

        <!-- ÁREA 3.1: EXAMES RECOMENDADOS E LIMITAÇÕES -->
        <section class="card-section">
          <div class="section-title">
            <span class="section-number">3.1</span>
            <div>
              <h2>Exames Recomendados & Risco de Falso Negativo</h2>
              <p>Avaliação criteriosa de acurácia, limitações e potencial de exclusão.</p>
            </div>
          </div>

          <div id="tests-container" class="tests-stream">
            <div class="empty-hint">Nenhum exame pendente no momento.</div>
          </div>
        </section>

        <!-- ÁREA 3.2: CRITÉRIOS E ESCORES INTEGRADOS (CALC-ENGINE) -->
        <section class="card-section">
          <div class="section-title">
            <span class="section-number">3.2</span>
            <div>
              <h2>Critérios e Escores Clínicos Integrados</h2>
              <p>Cálculos objetivos alimentados transparentemente pelo Motor de Decisão Clínica.</p>
            </div>
          </div>

          <div id="scores-container" class="scores-stream">
            <div class="empty-hint">Aguardando dados clínicos para avaliação de escores.</div>
          </div>
        </section>
      </div>

      <!-- COLUNA DA DIREITA: DIAGNÓSTICO DIFERENCIAL (DOIS EIXOS) E SÍNTESE -->
      <div class="right-column">
        <!-- COGNITIVE FORCING BANNER -->
        <div id="cognitive-forcing-box" class="cognitive-forcing-banner" style="display: none;">
          <div class="cf-header">
            <span class="cf-icon">⚠️</span>
            <strong>ALERTA DE SEGURANÇA COGNITIVA (Segunda Linha):</strong>
          </div>
          <p id="cf-message"></p>
        </div>

        <!-- ÁREA 2: DIAGNÓSTICO DIFERENCIAL EM DOIS EIXOS -->
        <section class="card-section differential-section">
          <div class="section-title">
            <span class="section-number">02</span>
            <div>
              <h2>Diagnóstico Diferencial em Dois Eixos</h2>
              <p>Segregação ortogonal: probabilidade estatística vs periculosidade iminente.</p>
            </div>
          </div>

          <!-- EIXO 2: O QUE NÃO POSSO DEIXAR PASSAR? -->
          <div class="axis-block axis-critical-block">
            <div class="axis-header">
              <span class="axis-tag axis-tag-critical">EIXO 2</span>
              <h3>O que não posso deixar passar?</h3>
              <small>Condições graves/tempo-dependentes mantidas até exclusão formal</small>
            </div>
            <div id="axis2-list" class="hypotheses-list">
              <div class="empty-hint">Nenhuma condição crítica detectada para a queixa selecionada.</div>
            </div>
          </div>

          <!-- EIXO 1: O QUE É MAIS PROVÁVEL? -->
          <div class="axis-block axis-probable-block">
            <div class="axis-header">
              <span class="axis-tag axis-tag-probable">EIXO 1</span>
              <h3>O que é mais provável?</h3>
              <small>Hipóteses que melhor explicam o conjunto dos achados</small>
            </div>
            <div id="axis1-list" class="hypotheses-list">
              <div class="empty-hint">Aguardando achados para ordenar a plausibilidade clínica.</div>
            </div>
          </div>
        </section>

        <!-- ÁREA 5: SÍNTESE DA INVESTIGAÇÃO E EXPORTAÇÃO SEGURA -->
        <section class="card-section synthesis-section">
          <div class="section-title">
            <span class="section-number">05</span>
            <div>
              <h2>Síntese Clínica Estruturada (SOAP)</h2>
              <p>Única fonte de verdade da sessão, atualizada dinamicamente com estilo telegráfico.</p>
            </div>
          </div>

          <div class="soap-header-bar">
            <span id="soap-tag-badge" class="soap-tag-badge">[Inicial]</span>
            <small class="soap-session-note">Estado exclusivamente em memória · Sem persistência externa</small>
          </div>

          <div id="synthesis-output" class="synthesis-box">
            <p class="empty-hint">A síntese será formulada dinamicamente à medida que você registrar os dados do paciente.</p>
          </div>

          <div class="synthesis-actions">
            <button type="button" id="btn-copy-synthesis" class="btn-copy" title="Copia a síntese clínica SOAP para a área de transferência">
              📋 Copiar Síntese SOAP para Prontuário
            </button>
            <button type="button" id="btn-record-reassessment" class="btn-secondary" title="Registra ponto de reavaliação clínica com timestamp [Reavaliação - HH:MM]">
              ⏱️ Registrar Reavaliação no Leito
            </button>
            <span id="copy-feedback" class="copy-feedback-text"></span>
          </div>
        </section>
      </div>
    </div>
  </main>
</StarlightPage>

<script>
  import { InMemoryIDGStore } from '../../lib/idg/state/in-memory-store';
  import type {
    IDGEvaluation,
    IDGState,
    ClinicalPresentationId,
    FindingStatus,
    EvaluatedHypothesis,
    ClinicalSafetyAlert,
    DiagnosticQuestionDef,
    DiagnosticTestDef,
    ScoreAdapterResult,
  } from '../../lib/idg/types';

  // Cria instância 100% em memória da IDG
  const store = new InMemoryIDGStore();

  // Elementos do DOM
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip-button');
  const txtFreeDescription = document.getElementById('txt-free-description') as HTMLTextAreaElement;
  const txtInitialHypotheses = document.getElementById('txt-initial-hypotheses') as HTMLInputElement;
  const btnReset = document.getElementById('btn-reset-investigation') as HTMLButtonElement;
  const btnImportContext = document.getElementById('btn-import-context') as HTMLButtonElement;
  const importStatusMsg = document.getElementById('import-status-msg') as HTMLSpanElement;

  const secSafetyAlerts = document.getElementById('sec-safety-alerts') as HTMLElement;
  const alertsList = document.getElementById('alerts-list') as HTMLElement;

  const cognitiveForcingBox = document.getElementById('cognitive-forcing-box') as HTMLElement;
  const cfMessage = document.getElementById('cf-message') as HTMLElement;

  const axis1List = document.getElementById('axis1-list') as HTMLElement;
  const axis2List = document.getElementById('axis2-list') as HTMLElement;

  const questionsContainer = document.getElementById('questions-container') as HTMLElement;
  const testsContainer = document.getElementById('tests-container') as HTMLElement;
  const scoresContainer = document.getElementById('scores-container') as HTMLElement;

  const synthesisOutput = document.getElementById('synthesis-output') as HTMLElement;
  const btnCopySynthesis = document.getElementById('btn-copy-synthesis') as HTMLButtonElement;
  const btnRecordReassessment = document.getElementById('btn-record-reassessment') as HTMLButtonElement;
  const soapTagBadge = document.getElementById('soap-tag-badge') as HTMLSpanElement;
  const copyFeedback = document.getElementById('copy-feedback') as HTMLSpanElement;

  let latestSoapMarkdown = '';

  // Interação delegada com as apresentações clínicas.
  // A delegação evita perder eventos caso os chips sejam recriados pela interface
  // ou a página seja restaurada por navegação parcial do Starlight.
  const presentationsContainer = document.querySelector('.presentations-chips');
  const presentationFeedback = document.getElementById('presentation-feedback');

  if (presentationFeedback) {
    presentationFeedback.textContent = presentationsContainer
      ? 'Interação pronta: selecione uma ou mais apresentações.'
      : 'Erro: contêiner de apresentações não encontrado na página.';
  }

  presentationsContainer?.addEventListener('click', (event: MouseEvent) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const chip = target.closest<HTMLButtonElement>('.chip-button[data-presentation-id]');
    if (!chip || !presentationsContainer.contains(chip)) return;

    event.preventDefault();
    const pId = chip.getAttribute('data-presentation-id') as ClinicalPresentationId;
    if (!pId) return;

    try {
      store.togglePresentation(pId);
      renderPresentationsState(store.getState().presentations);
      if (presentationFeedback) presentationFeedback.textContent = '';
    } catch (error) {
      // O estado pode ter sido atualizado antes de uma falha na reavaliação.
      // Mantém o feedback visual e informa explicitamente que o motor falhou.
      console.error('[IDG] Falha ao processar a apresentação selecionada:', error);
      renderPresentationsState(store.getState().presentations);
      if (presentationFeedback) {
        presentationFeedback.textContent =
          'Apresentação selecionada, mas houve falha ao reavaliar o caso. Abra o console para identificar o erro.';
      }
    }
  });

  // Atualização da descrição livre
  txtFreeDescription?.addEventListener('input', () => {
    store.setFreeTextDescription(txtFreeDescription.value);
  });

  // Atualização das hipóteses iniciais do médico
  txtInitialHypotheses?.addEventListener('input', () => {
    const raw = txtInitialHypotheses.value;
    const items = raw.split(',').map((s) => s.trim()).filter(Boolean);
    store.setUserInitialHypotheses(items);
  });

  // Botão Limpar / Reset
  btnReset?.addEventListener('click', () => {
    if (confirm('Tem certeza de que deseja descartar todos os dados desta investigação? Esta ação é irreversível.')) {
      store.reset();
      if (txtFreeDescription) txtFreeDescription.value = '';
      if (txtInitialHypotheses) txtInitialHypotheses.value = '';
      if (importStatusMsg) importStatusMsg.textContent = '';
      if (copyFeedback) copyFeedback.textContent = '';
    }
  });

  // Botão Importar ContextoPaciente (leitura em memória)
  btnImportContext?.addEventListener('click', () => {
    const res = store.importContextoPaciente();
    if (importStatusMsg) {
      if (res.importedCount > 0) {
        importStatusMsg.textContent = `✓ ${res.importedCount} parâmetro(s) importado(s) para a memória.`;
        importStatusMsg.style.color = 'var(--sl-color-accent-high)';
      } else {
        importStatusMsg.textContent = 'Nenhum dado prévio encontrado na sessão geral.';
        importStatusMsg.style.color = 'var(--sl-color-gray-3)';
      }
    }
  });

  // Botão Copiar Síntese SOAP
  btnCopySynthesis?.addEventListener('click', () => {
    const textToCopy = latestSoapMarkdown || synthesisOutput?.innerText || '';
    if (!textToCopy.trim()) return;

    navigator.clipboard.writeText(textToCopy).then(() => {
      if (copyFeedback) {
        copyFeedback.textContent = '✓ Síntese SOAP copiada em Markdown para o prontuário!';
        setTimeout(() => {
          if (copyFeedback) copyFeedback.textContent = '';
        }, 3000);
      }
    }).catch(() => {
      if (copyFeedback) copyFeedback.textContent = 'Falha ao copiar automaticamente. Selecione e copie manualmente.';
    });
  });

  // Botão Registrar Reavaliação no Leito
  btnRecordReassessment?.addEventListener('click', () => {
    store.recordReassessment();
    if (copyFeedback) {
      copyFeedback.textContent = '⏱️ Ponto de reavaliação registrado com sucesso.';
      setTimeout(() => {
        if (copyFeedback) copyFeedback.textContent = '';
      }, 2500);
    }
  });

  // Isola as renderizações: uma falha visual não deve interromper os demais painéis.
  function safeRender(
    section: string,
    targetId: string | null,
    render: () => void,
  ): void {
    const target = targetId ? document.getElementById(targetId) : null;
    target?.querySelector('.idg-render-error')?.remove();
    try {
      render();
    } catch (error) {
      console.error(`[IDG] Falha ao renderizar ${section}:`, error);
      if (target) {
        const notice = document.createElement('p');
        notice.className = 'idg-render-error';
        notice.setAttribute('role', 'alert');
        notice.textContent = `Não foi possível atualizar esta seção (${section}). Consulte o console para detalhes.`;
        target.prepend(notice);
      }
    }
  }

  // Subscrição reativa ao store: cada subsistema é renderizado isoladamente.
  store.subscribe((evaluation, state) => {
    safeRender('apresentações', null, () => renderPresentationsState(state.presentations));
    safeRender('alertas', 'alerts-list', () => renderAlerts(evaluation.activeSafetyAlerts));
    safeRender('alertas cognitivos', 'cf-message', () => renderCognitiveForcing(evaluation.unconsideredDangerous));
    safeRender('eixo de condições críticas', 'axis2-list', () => renderAxis2(evaluation.axis2Critical, state));
    safeRender('eixo de hipóteses prováveis', 'axis1-list', () => renderAxis1(evaluation.axis1Probable, state));
    safeRender('perguntas adaptativas', 'questions-container', () => renderQuestions(evaluation.suggestedQuestions, state));
    safeRender('exames recomendados', 'tests-container', () => renderTests(evaluation.suggestedTests));
    safeRender('escores', 'scores-container', () => renderScores(evaluation.integratedScores));
    safeRender('síntese SOAP', 'synthesis-output', () => renderSynthesis(evaluation, state));
  });

  function renderPresentationsState(selected: ClinicalPresentationId[]) {
    chips.forEach((chip) => {
      const pId = chip.getAttribute('data-presentation-id') as ClinicalPresentationId;
      const isSelected = selected.includes(pId);
      chip.classList.toggle('chip-selected', isSelected);
      chip.setAttribute('aria-pressed', String(isSelected));
    });
  }

  function renderAlerts(alerts: ClinicalSafetyAlert[]) {
    if (!secSafetyAlerts || !alertsList) return;
    if (alerts.length === 0) {
      secSafetyAlerts.style.display = 'none';
      alertsList.innerHTML = '';
      return;
    }

    secSafetyAlerts.style.display = 'block';
    alertsList.innerHTML = alerts
      .map(
        (a) => `
        <div class="alert-card alert-card-${a.severity}">
          <div class="alert-card-title">
            <strong>${a.title}</strong>
          </div>
          <p class="alert-card-desc">${a.description}</p>
          <div class="alert-card-action">
            <span class="action-badge">CONDUTA IMEDIATA:</span>
            <span>${a.immediateActionRequired}</span>
          </div>
          <small class="alert-ref">Diretriz: ${a.ruleReference}</small>
        </div>
      `,
      )
      .join('');
  }

  function renderCognitiveForcing(unconsidered: EvaluatedHypothesis[]) {
    if (!cognitiveForcingBox || !cfMessage) return;
    if (unconsidered.length === 0) {
      cognitiveForcingBox.style.display = 'none';
      return;
    }

    cognitiveForcingBox.style.display = 'block';
    const names = unconsidered.map((h) => `<strong>${h.def.name}</strong>`).join(', ');
    cfMessage.innerHTML = `Você não incluiu inicialmente entre as suas hipóteses as seguintes condições de alto risco que se enquadram nesta queixa: ${names}. Certifique-se de investigá-las ou justificá-las antes de encerrar o raciocínio.`;
  }

  function getStatusBadge(status: string): string {
    const map: Record<string, { label: string; cls: string }> = {
      sustentada: { label: 'Sustentada', cls: 'badge-sustentada' },
      em_investigacao: { label: 'Em Investigação', cls: 'badge-investigacao' },
      enfraquecida: { label: 'Enfraquecida', cls: 'badge-enfraquecida' },
      nao_demonstrada: { label: 'Não Demonstrada', cls: 'badge-nao-demonstrada' },
      confirmada: { label: 'Confirmada', cls: 'badge-confirmada' },
      nao_avaliada: { label: 'Não Avaliada', cls: 'badge-nao-avaliada' },
    };
    const item = map[status] || { label: status, cls: 'badge-nao-avaliada' };
    return `<span class="status-badge ${item.cls}">${item.label}</span>`;
  }

  function renderAxis2(hypotheses: EvaluatedHypothesis[], state: IDGState) {
    if (!axis2List) return;
    if (hypotheses.length === 0) {
      axis2List.innerHTML = '<div class="empty-hint">Nenhuma condição crítica pendente de exclusão.</div>';
      return;
    }

    axis2List.innerHTML = hypotheses
      .map((h) => {
        const timeBadge = h.def.isTimeSensitive
          ? `<span class="time-sensitive-pill">⏱️ Tempo-Dependente: ${h.def.timeWindowDescription || 'Intervenção imediata'}</span>`
          : '';

        const missing = h.missingCriticalFindings.length > 0
          ? `<div class="missing-findings-line">
              <span class="missing-label">Dados críticos pendentes:</span>
              ${h.missingCriticalFindings.slice(0, 3).map((f) => `<span class="missing-pill">${f}</span>`).join('')}
             </div>`
          : '';

        const bayes = h.bayesianCalculation
          ? `<div class="bayes-box">
              <span class="bayes-title">Estimativa Bayesiana:</span>
              <span>Pós-teste: ~${(h.bayesianCalculation.postTestProb * 100).toFixed(0)}% (RV combinada: ${h.bayesianCalculation.combinedLR.toFixed(1)})</span>
              <small class="bayes-caution">${h.bayesianCalculation.cautionNote}</small>
             </div>`
          : '';

        return `
          <div class="hypothesis-card hypothesis-card-critical">
            <div class="hypo-header">
              <div>
                <strong class="hypo-title">${h.def.name}</strong>
                <span class="danger-pill danger-pill-${h.def.dangerLevel}">${h.def.dangerLevel.toUpperCase()}</span>
              </div>
              ${getStatusBadge(h.status)}
            </div>
            ${timeBadge}

            <!-- Barra de priorização multidimensional -->
            <div class="matrix-scores-bar">
              <span class="matrix-pill">Compatibilidade: ${h.multidimensional.compatibility}%</span>
              <span class="matrix-pill matrix-pill-severity">Gravidade: ${h.multidimensional.severity}/10</span>
              <span class="matrix-pill matrix-pill-urgency">Urgência: ${h.multidimensional.urgency}/10</span>
            </div>

            <div class="hypo-guidance">
              <strong>Próximo passo obrigatório:</strong> ${h.investigationGuidance}
            </div>

            ${missing}

            <!-- Divulgação progressiva: detalhes adicionais sob demanda -->
            <details class="progressive-details">
              <summary class="progressive-summary">Ver justificativa e estimativa bayesiana</summary>
              <p class="hypo-rationale">${h.def.summaryRationale}</p>
              ${bayes}
              <div class="matched-pills">
                <span class="pill-fav">✓ ${h.matchedFavorableFindings.length} achado(s) a favor</span>
                <span class="pill-con">✗ ${h.matchedContraryFindings.length} achado(s) contra</span>
              </div>
            </details>
          </div>
        `;
      })
      .join('');
  }

  function renderAxis1(hypotheses: EvaluatedHypothesis[], state: IDGState) {
    if (!axis1List) return;
    if (hypotheses.length === 0) {
      axis1List.innerHTML = '<div class="empty-hint">Aguardando achados para ordenar a plausibilidade clínica.</div>';
      return;
    }

    axis1List.innerHTML = hypotheses
      .map((h) => {
        const favCount = h.matchedFavorableFindings.length;
        const conCount = h.matchedContraryFindings.length;

        const exclusionTag = h.exclusionStatus?.excluded
          ? `<div class="exclusion-banner">
              <strong>Excluída por critério formal:</strong> ${h.exclusionStatus.reason}
              <small>${h.exclusionStatus.caveats || ''}</small>
             </div>`
          : '';

        return `
          <div class="hypothesis-card ${h.exclusionStatus?.excluded ? 'hypothesis-card-excluded' : ''}">
            <div class="hypo-header">
              <div>
                <strong class="hypo-title">${h.def.name}</strong>
                <span class="category-pill">${h.def.category.replace('_', ' ')}</span>
              </div>
              <div class="hypo-right">
                <span class="score-pill">Plausibilidade: ${h.scoreProbable}%</span>
                ${getStatusBadge(h.status)}
              </div>
            </div>

            <div class="matrix-scores-bar">
              <span class="matrix-pill">Compatibilidade: ${h.multidimensional.compatibility}%</span>
              <span class="matrix-pill">Prioridade Composta: ${h.multidimensional.compositePriority}</span>
            </div>

            ${exclusionTag}

            <!-- Divulgação progressiva -->
            <details class="progressive-details">
              <summary class="progressive-summary">Ver justificativa e achados confrontados</summary>
              <p class="hypo-rationale">${h.def.summaryRationale}</p>
              <div class="matched-pills">
                <span class="pill-fav">✓ ${favCount} achado(s) a favor</span>
                <span class="pill-con">✗ ${conCount} achado(s) contra</span>
              </div>
            </details>
          </div>
        `;
      })
      .join('');
  }

  function renderQuestions(questions: DiagnosticQuestionDef[], state: IDGState) {
    if (!questionsContainer) return;
    if (questions.length === 0) {
      questionsContainer.innerHTML = '<div class="empty-hint">Nenhuma pergunta adicional pendente para as hipóteses ativas.</div>';
      return;
    }

    questionsContainer.innerHTML = questions
      .slice(0, 6)
      .map((q) => {
        const currentVal = state.findings[q.targetFindingId] || 'desconhecido';
        return `
          <div class="question-item">
            <div class="question-header">
              <span class="priority-pill priority-${q.priority}">${q.priority.toUpperCase()}</span>
              <p class="question-text">${q.text}</p>
            </div>
            <small class="question-utility"><strong>Utilidade Clínica:</strong> ${q.clinicalUtility}</small>
            <div class="answer-buttons">
              <button type="button" class="btn-ans btn-ans-pos ${currentVal === 'presente' ? 'ans-active' : ''}" data-fid="${q.targetFindingId}" data-val="presente">
                ✓ Presente
              </button>
              <button type="button" class="btn-ans btn-ans-neg ${currentVal === 'ausente' ? 'ans-active' : ''}" data-fid="${q.targetFindingId}" data-val="ausente">
                ✗ Ausente
              </button>
              <button type="button" class="btn-ans btn-ans-unk ${currentVal === 'desconhecido' || currentVal === 'nao_avaliado' ? 'ans-active' : ''}" data-fid="${q.targetFindingId}" data-val="desconhecido">
                ? Desconhecido
              </button>
            </div>
          </div>
        `;
      })
      .join('');

    // Listener para botões de resposta
    questionsContainer.querySelectorAll<HTMLButtonElement>('.btn-ans').forEach((btn) => {
      btn.addEventListener('click', () => {
        const fid = btn.getAttribute('data-fid')!;
        const val = btn.getAttribute('data-val') as FindingStatus;
        store.setFinding(fid, val);
      });
    });
  }

  function renderTests(tests: DiagnosticTestDef[]) {
    if (!testsContainer) return;
    if (tests.length === 0) {
      testsContainer.innerHTML = '<div class="empty-hint">Nenhum exame prioritário pendente.</div>';
      return;
    }

    testsContainer.innerHTML = tests
      .map((t) => {
        const canExcludeBadge = t.canExclude
          ? '<span class="can-exclude-pill">Pode Excluir se Negativo</span>'
          : '<span class="cannot-exclude-pill">Não Exclui a Doença se Normal</span>';

        return `
          <div class="test-item test-priority-${t.priority}">
            <div class="test-header">
              <strong class="test-name">${t.name}</strong>
              <span class="test-priority-badge">${t.priority.toUpperCase()}</span>
            </div>
            <div class="test-meta">
              ${canExcludeBadge}
              <small>Investiga: <em>${t.targetHypothesisIds.join(', ')}</em></small>
            </div>
            <details class="progressive-details">
              <summary class="progressive-summary">Ver limitações e risco de falso negativo</summary>
              <div class="test-details">
                <div><strong>Limitações:</strong> ${t.limitations}</div>
                <div><strong>Risco de Falso Negativo:</strong> ${t.falseNegativeRisk}</div>
              </div>
            </details>
          </div>
        `;
      })
      .join('');
  }

  function renderScores(scores: ScoreAdapterResult[]) {
    if (!scoresContainer) return;
    if (scores.length === 0) {
      scoresContainer.innerHTML = '<div class="empty-hint">Nenhum escore aplicável no momento.</div>';
      return;
    }

    scoresContainer.innerHTML = scores
      .map((s) => {
        if (s.status === 'ok') {
          return `
            <div class="score-card score-ok">
              <div class="score-top">
                <strong>${s.scoreName}</strong>
                <span class="score-val">${s.value} ${s.summary ? `(${s.summary})` : ''}</span>
              </div>
              <p class="score-desc">${s.clinicalInterpretation}</p>
              <small class="score-limits"><strong>Limitações:</strong> ${s.limitations}</small>
            </div>
          `;
        } else {
          return `
            <div class="score-card score-pending">
              <div class="score-top">
                <strong>${s.scoreName}</strong>
                <span class="score-status-badge">Aguardando dados</span>
              </div>
              <p class="score-desc">${s.clinicalInterpretation}</p>
            </div>
          `;
        }
      })
      .join('');
  }

  function escapeHtml(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (char) => {
      const entities: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      };
      return entities[char];
    });
  }

  function renderSynthesis(evaluation: IDGEvaluation, state: IDGState) {
    if (!synthesisOutput) return;

    const soap = evaluation.soap;
    latestSoapMarkdown = soap.formattedMarkdown || '';

    if (soapTagBadge) {
      soapTagBadge.textContent = soap.versionTag;
      const cleanCls = soap.versionTag.replace(/[^a-zA-Z0-9]/g, '').toLowerCase();
      soapTagBadge.className = `soap-tag-badge soap-tag-${cleanCls}`;
    }

    const hasClinicalData =
      state.presentations.length > 0 ||
      Boolean(state.freeTextDescription.trim()) ||
      Object.keys(state.findings).length > 0 ||
      Object.keys(state.testResults).length > 0;

    if (!hasClinicalData) {
      synthesisOutput.innerHTML = '<p class="empty-hint">A síntese SOAP será formulada à medida que você registrar os dados clínicos.</p>';
      return;
    }

    const list = (items: string[], emptyLabel: string) =>
      items.length
        ? items.map((item) => `<li>${escapeHtml(item)}</li>`).join('')
        : `<li>${escapeHtml(emptyLabel)}</li>`;

    synthesisOutput.innerHTML = `
      <div class="soap-block soap-block-s">
        <div class="soap-block-header"><span class="soap-letter">S</span><h4>Subjetivo</h4></div>
        <div class="soap-content"><p>${escapeHtml(soap.subjective || 'Dados subjetivos não informados.')}</p></div>
      </div>

      <div class="soap-block soap-block-o">
        <div class="soap-block-header"><span class="soap-letter">O</span><h4>Objetivo</h4></div>
        <div class="soap-content">
          <p><strong>Sinais vitais:</strong> ${escapeHtml(soap.objective.vitalSigns)}</p>
          <p><strong>Exame físico:</strong> ${escapeHtml(soap.objective.physicalExam)}</p>
          <p><strong>Exames disponíveis:</strong> ${escapeHtml(soap.objective.availableTests)}</p>
        </div>
      </div>

      <div class="soap-block soap-block-a">
        <div class="soap-block-header"><span class="soap-letter">A</span><h4>Avaliação</h4></div>
        <div class="soap-content">
          <p><strong>Síntese:</strong> ${escapeHtml(soap.assessment.unifyingSynthesis)}</p>
          <div class="soap-axis-subblock">
            <strong>Hipóteses mais prováveis:</strong>
            <ul>${soap.assessment.priorityDifferentials.length
              ? soap.assessment.priorityDifferentials.map((d) => `<li><strong>${escapeHtml(d.name)}</strong> — ${escapeHtml(d.oneLineRationale)} ${d.severityTag ? escapeHtml(d.severityTag) : ''}</li>`).join('')
              : '<li>Aguardando dados discriminatórios.</li>'}</ul>
          </div>
          <div class="soap-axis-subblock soap-critical-subblock">
            <strong>Condições graves ainda não excluídas:</strong>
            <ul>${soap.assessment.unruledOutDangerous.length
              ? soap.assessment.unruledOutDangerous.map((d) => `<li><strong>${escapeHtml(d.name)}</strong> — ${escapeHtml(d.whatIsMissingToExclude)}</li>`).join('')
              : '<li>Nenhuma condição adicional identificada nesta etapa.</li>'}</ul>
          </div>
          <p><strong>Incerteza:</strong> ${escapeHtml(soap.assessment.uncertaintyDegree)}</p>
          ${soap.assessment.criticalGaps.length
            ? `<p><strong>Lacunas relevantes:</strong> ${escapeHtml(soap.assessment.criticalGaps.join('; '))}</p>`
            : ''}
        </div>
      </div>

      <div class="soap-block soap-block-p">
        <div class="soap-block-header"><span class="soap-letter">P</span><h4>Plano / Conduta</h4></div>
        <div class="soap-content">
          ${soap.plan.immediate.length
            ? `<div class="soap-plan-alert"><strong>Ações imediatas sugeridas:</strong><ul>${list(soap.plan.immediate, '')}</ul></div>`
            : ''}
          <p><strong>Investigação sugerida:</strong></p>
          <ul>${list(soap.plan.investigation, 'Nenhum exame adicional priorizado pela base de conhecimento para os dados atuais.')}</ul>
          ${soap.plan.therapeuticsToConsider.length
            ? `<p><strong>Intervenções terapêuticas a considerar:</strong></p><ul>${list(soap.plan.therapeuticsToConsider, '')}</ul>`
            : ''}
          <p><strong>Reavaliação:</strong></p>
          <ul>${list(soap.plan.reassessmentAndAlerts, 'Reavaliar conforme evolução clínica.')}</ul>
        </div>
      </div>
      <div class="synth-block synth-caveat"><small>${escapeHtml(evaluation.synthesis.disclaimer)}</small></div>
    `;
  }
</script>

