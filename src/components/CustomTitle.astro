---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const entry = Astro.locals.starlightRoute?.entry;
const data = entry?.data;

const autores = data?.autores ?? [];
const revisor = data?.revisor;
const date = data?.date;
const doi = data?.doi;
const description = data?.description;

// Formata a data para o padrão brasileiro
const formattedDate = date
  ? new Date(date).toLocaleDateString('pt-BR')
  : null;

// Processa os dados do revisor
let revisorNome = revisor;
let revisorOrcid = null;

if (revisor) {
  const match = revisor.match(
    /^(.*?)\s*\((https?:\/\/orcid\.org\/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X])\)\s*$/
  );

  if (match) {
    revisorNome = match[1].trim();
    revisorOrcid = match[2];
  }
}

const hasMetadata =
  description ||
  autores.length > 0 ||
  revisor ||
  formattedDate ||
  doi;
---

<Default {...Astro.props} />

{hasMetadata && (
  <div
    style="background-color: var(--sl-color-bg-nav); padding: 1.5rem; border-radius: 8px; margin: 1.5rem 0 2.5rem 0; border: 1px solid var(--sl-color-hairline);"
  >
    {description && (
      <p style="font-size: 1.05rem; margin-top: 0; margin-bottom: 1rem;">
        <em><strong>Resumo:</strong> {description}</em>
      </p>
    )}

    {(description &&
      (autores.length > 0 || revisor || formattedDate || doi)) && (
      <hr
        style="border-color: var(--sl-color-hairline); margin-bottom: 1rem;"
      />
    )}

    <div
      style="display: grid; gap: 0.75rem; font-size: 0.9rem; color: var(--sl-color-text-muted);"
    >
      {autores.length > 0 && (
        <div>
          ✍️ <strong>Autores:</strong>

          <div style="margin-top: 0.4rem; display: grid; gap: 0.25rem;">
            {autores.map((autor) => (
              <div>
                {autor.nome}
                {autor.orcid && (
                  <>
                    {' — '}
                    <a
                      href={`https://orcid.org/${autor.orcid}`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      ORCID: {autor.orcid}
                    </a>
                  </>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      {revisor && (
        <div>
          👀 <strong>Revisão Científica:</strong>{' '}
          {revisorNome}
          {revisorOrcid && (
            <>
              {' — '}
              <a
                href={revisorOrcid}
                target="_blank"
                rel="noopener noreferrer"
              >
                ORCID: {revisorOrcid.replace('https://orcid.org/', '')}
              </a>
            </>
          )}
        </div>
      )}

      {formattedDate && (
        <div>
          📅 <strong>Publicado em:</strong> {formattedDate}
        </div>
      )}

      {doi && (
        <div>
          🎓 <strong>DOI:</strong>{' '}
          <a
            href={`https://doi.org/${doi}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {doi}
          </a>
        </div>
      )}
    </div>
  </div>
)}
