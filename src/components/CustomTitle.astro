---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const entry = Astro.locals.starlightRoute?.entry;
const data = entry?.data;

const autores = data?.autores;
const revisor = data?.revisor;
const date = data?.date;
const doi = data?.doi;
const description = data?.description;

// Formata a data para o padrão brasileiro
const formattedDate = date
  ? new Date(date).toLocaleDateString('pt-BR')
  : null;

const hasAutores = autores && autores.length > 0;
---

<!-- Renderiza o título original (H1) -->
<Default {...Astro.props} />

<!-- Caixa de metadados acadêmicos -->
{(description || hasAutores || revisor || formattedDate || doi) && (
  <div
    style="background-color: var(--sl-color-bg-nav); padding: 1.5rem; border-radius: 8px; margin: 1.5rem 0 2.5rem 0; border: 1px solid var(--sl-color-hairline);"
  >
    {description && (
      <p style="font-size: 1.05rem; margin-top: 0; margin-bottom: 1rem;">
        <em><strong>Resumo:</strong> {description}</em>
      </p>
    )}

    {(description && (hasAutores || revisor || formattedDate || doi)) && (
      <hr
        style="border-color: var(--sl-color-hairline); margin-bottom: 1rem;"
      />
    )}

    <div
      style="display: grid; gap: 0.75rem; font-size: 0.9rem; color: var(--sl-color-text-muted);"
    >
      {hasAutores && (
        <div>
          ✍️ <strong>Autores:</strong>

          <div style="margin-top: 0.5rem; display: grid; gap: 0.35rem;">
            {autores.map((autor) => (
              <div>
                {autor.nome}

                {autor.orcid && (
                  <>
                    {' — '}
                    <a
                      href={`https://orcid.org/${autor.orcid}`}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      ORCID: {autor.orcid}
                    </a>
                  </>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      {revisor && (
        <div>
          👀 <strong>Revisão Científica:</strong> {revisor}
        </div>
      )}

      {formattedDate && (
        <div>
          📅 <strong>Publicado em:</strong> {formattedDate}
        </div>
      )}

      {doi && (
        <div>
          🎓 <strong>DOI:</strong>{' '}
          <a
            href={`https://doi.org/${doi}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {doi}
          </a>
        </div>
      )}
    </div>
  </div>
)}
