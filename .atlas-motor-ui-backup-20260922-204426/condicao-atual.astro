<style>
  .subsection-block {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .subsection-block:first-of-type { border-top: 0; padding-top: 0; }
  .subsection-block h3 { margin: 0 0 0.4rem; font-size: 1rem; }
  .clinical-summary {
    margin-top: 1.25rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-7, transparent);
    line-height: 1.7;
  }
  .clinical-summary strong { font-weight: 700; }
</style>
<script>
  import type { ContextoPaciente, ValorClinico } from '../../lib/calc-engine/types';

  type Campo = HTMLInputElement | HTMLSelectElement;

  let inicializado = false;

  function parseBoolean(value: string): boolean | null {
    if (value === 'true') return true;
    if (value === 'false') return false;
    return null;
  }

  function parseField(field: Campo): ValorClinico {
    const value = field.value.trim();
    if (value === '') return null;

    if (field instanceof HTMLInputElement && field.type === 'number') {
      const n = Number(value.replace(',', '.'));
      return Number.isFinite(n) ? n : null;
    }

    const boolean = parseBoolean(value);
    if (boolean !== null) return boolean;

    return value;
  }

  function collectData(form: HTMLFormElement): ContextoPaciente {
    const data: ContextoPaciente = {};

    form.querySelectorAll<Campo>('input, select').forEach((field) => {
      const value = parseField(field);
      if (value !== null) data[field.name] = value;
    });

    // Os componentes do Glasgow vêm de <select>, portanto chegam
    // como strings. Convertê-los aqui permite derivar automaticamente
    // o GCS e reutilizá-lo no APACHE II e no SOFA-2.
    for (const campo of [
      'glasgow_ocular',
      'glasgow_verbal',
      'glasgow_motor',
    ] as const) {
      const valor = data[campo];

      if (typeof valor === 'string' && valor.trim() !== '') {
        const numero = Number(valor);

        if (Number.isFinite(numero)) {
          data[campo] = numero;
        }
      }
    }

    const tipoSuporte = data.suporte_ventilatorio_tipo;
    if (typeof tipoSuporte === 'string' && tipoSuporte !== '' && tipoSuporte !== 'nenhum') {
      data.suporte_ventilatorio_avancado = true;
    } else if (tipoSuporte === 'nenhum') {
      data.suporte_ventilatorio_avancado = false;
    }

    const o2 = data.o2_suplementar;
    const fio2Percent = data.fio2_percent;
    if (typeof fio2Percent === 'number') {
      data.fio2 = fio2Percent / 100;
    } else if (o2 === false) {
      data.fio2 = 0.21;
    }

    const ocular = data.glasgow_ocular;
    const verbal = data.glasgow_verbal;
    const motor = data.glasgow_motor;
    const gcsPre = data.glasgow_pre_sedacao;
    const gcsLimitado = data.glasgow_avaliacao_limitada;

    if (gcsLimitado === true && typeof gcsPre === 'number') {
      data.gcs = gcsPre;
    } else if (
      typeof ocular === 'number' &&
      typeof verbal === 'number' &&
      typeof motor === 'number'
    ) {
      data.gcs = ocular + verbal + motor;
    }

    const vasoativoOn = data.vasoativos_em_uso;
    const continuous = data.vasoativos_continuos_1h;

    if (vasoativoOn !== true || continuous === false) {
      data.norepinefrina = 0;
      data.epinefrina = 0;
      data.dopamina = 0;
      data.vasopressina = 0;
      data.dobutamina = 0;
      data.milrinona = 0;
      data.nitroprussiato = 0;
      data.nitroglicerina = 0;
    }

    const otherSOFA =
      Number(data.vasopressina ?? 0) > 0 ||
      Number(data.dobutamina ?? 0) > 0 ||
      Number(data.milrinona ?? 0) > 0;

    data.sofa2_outro_vasoativo = otherSOFA;
    data.sofa2_delirium_tratamento = data.delirium_tratamento;
    data.sofa2_norepinefrina = data.norepinefrina;
    data.sofa2_epinefrina = data.epinefrina;
    data.sofa2_suporte_ventilatorio = data.suporte_ventilatorio_avancado;
    data.sofa2_ecmo = data.ecmo_respiratorio;
    data.sofa2_suporte_mecanico_cardiovascular = data.suporte_mecanico_cardiovascular;
    data.sofa2_diurese_ml_hora =
      typeof data.diurese_ml === 'number' && typeof data.diurese_horas === 'number' && data.diurese_horas > 0
        ? data.diurese_ml / data.diurese_horas
        : undefined;
    data.sofa2_diurese_horas = data.diurese_horas;
    data.sofa2_trs = data.terapia_renal_substitutiva;

    return data;
  }

  function escapeHtml(value: unknown): string {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function formatNumber(value: unknown, digits = 1): string {
    if (typeof value !== 'number' || !Number.isFinite(value)) return String(value ?? '');
    return new Intl.NumberFormat('pt-BR', {
      minimumFractionDigits: digits,
      maximumFractionDigits: digits,
    }).format(value);
  }
    const assessmentDisplayOrder = [
      'imc', 'superficie-corporal', 'peso-ideal', 'peso-ajustado',
      'pam', 'shock-index', 'news2', 'sofa-2', 'apache-ii',
      'ckd-epi-2021', 'cockcroft-gault', 'fena', 'fe-ureia',
      'child-pugh', 'meld-3', 'albi',
      'osmolaridade-plasmatica', 'osmolaridade-efetiva', 'anion-gap', 'anion-gap-albumina', 'delta-gap', 'sodio-corrigido-glicemia',
      'rcri', 'padua', 'hiss', 'ciwa-ar', 'cows',
    ];

    function summaryValue(results, id, decimals = 2) {
      const item = results.find((entry) => entry.calc.id === id && entry.status === 'ok');
      if (!item || item.status !== 'ok') return null;
      const value = item.resultado.valor;
      return typeof value === 'number'
        ? (Number.isInteger(value) ? String(value) : value.toFixed(decimals).replace('.', ','))
        : String(value);
    }

    function summaryText(value, decimals = 2) {
      if (value === undefined || value === null || value === '') return '—';
      if (typeof value === 'number') {
        return Number.isInteger(value) ? String(value) : value.toFixed(decimals).replace('.', ',');
      }
      return String(value);
    }

    function summaryBool(value) {
      if (value === true) return 'Sim';
      if (value === false) return 'Não';
      return 'não informado';
    }

    function summarySex(value) {
      if (value === 'feminino') return 'Feminino';
      if (value === 'masculino') return 'Masculino';
      if (value === 'outro') return 'Outro/não aplicável';
      return 'não informado';
    }

    function summaryAdmission(value) {
      if (value === 'clinica') return 'Clínica';
      if (value === 'pos_operatorio_eletivo') return 'Pós-op eletivo';
      if (value === 'pos_operatorio_nao_eletivo') return 'Pós-op não eletivo';
      return 'não informado';
    }

    function summaryRespiratory(value) {
      if (value === 'nenhum') return 'Nenhum';
      if (value === 'alto_fluxo') return 'Alto fluxo';
      if (value === 'cpap') return 'CPAP';
      if (value === 'bipap_niv') return 'BiPAP / VNI';
      if (value === 'ventilacao_mecanica_invasiva') return 'Ventilação mecânica invasiva';
      if (value === 'ventilacao_domestica') return 'Ventilação domiciliar';
      return 'não informado';
    }

    function escapeSummary(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function strongSummary(value) {
      return `<strong>${escapeSummary(value)}</strong>`;
    }

    function orderedAssessmentSummary(resultados) {
      return assessmentDisplayOrder
        .map((id) => {
          const item = resultados.find((entry) => entry.calc.id === id && entry.status === 'ok');
          if (!item || item.status !== 'ok') return null;
          const value = summaryValue(resultados, id, 2);
          const labels = {
            'imc': 'IMC',
            'superficie-corporal': 'SC',
            'peso-ideal': 'Peso ideal',
            'peso-ajustado': 'Peso ajustado',
            'pam': 'PAM',
            'shock-index': 'IC',
            'news2': 'NEWS2',
            'sofa-2': 'SOFA',
            'apache-ii': 'APACHE II',
            'ckd-epi-2021': 'TFGe-EPI',
            'cockcroft-gault': 'ClCr-CG',
            'fena': 'FeNa',
            'fe-ureia': 'FeUreia',
            'child-pugh': 'Child',
            'meld-3': 'MELD',
            'albi': 'ALBI',
            'osmolaridade-plasmatica': 'Osm plasmática',
            'osmolaridade-efetiva': 'Osm efetiva',
            'anion-gap': 'AG',
            'anion-gap-albumina': 'AGc',
            'delta-gap': 'Delta gap',
            'sodio-corrigido-glicemia': 'Na corrigido',
            'rcri': 'RCRI',
            'padua': 'Pádua',
            'hiss': 'HISS',
            'ciwa-ar': 'CIWA-Ar',
            'cows': 'COWS',
          };
          return `${labels[id] ?? id} ${value}`;
        })
        .filter(Boolean)
        .join(' | ');
    }
    function renderAssessmentSummaryPlaceholder(data, resultados) {
      const ordered = orderedAssessmentSummary(resultados);
      if (typeof assessmentSummary !== 'undefined' && assessmentSummary) {
        assessmentSummary.innerHTML = ordered ? `Avaliação: ${escapeSummary(ordered)}` : 'Avaliação: —';
      }
      renderClinicalSummary(data, resultados);
    }


    function renderClinicalSummary(data, resultados) {
      const target = document.querySelector('#clinical-summary');
      if (!target) return;

      const fio2 = data.fio2_percent ?? (typeof data.fio2 === 'number' ? data.fio2 * 100 : null);
      const gcs = data.gcs;
      const o = data.glasgow_ocular;
      const v = data.glasgow_verbal;
      const m = data.glasgow_motor;
      const healthStatus = data.insuficiencia_organica_grave_imunossupressao === true
        ? 'imunossuprimido'
        : data.insuficiencia_organica_grave_imunossupressao === false
          ? 'hígido'
          : 'não informado';
      const ascite = data.ascite && data.ascite !== 'nenhuma' ? 'Sim' : data.ascite === 'nenhuma' ? 'Não' : 'não informado';

      const paragraphs = [
        `Paciente ${strongSummary(summaryText(data.idade, 0))}a, ${strongSummary(summarySex(data.sexo))}, ${strongSummary(summaryText(data.peso, 1))}kg, ${strongSummary(summaryText(data.altura, 0))}cm. Admissão ${strongSummary(summaryAdmission(data.tipo_admissao))}; ${strongSummary(healthStatus)}.`,
        `SSVV: PA ${strongSummary(`${summaryText(data.pas, 0)}x${summaryText(data.pad, 0)}`)}, FC ${strongSummary(summaryText(data.fc, 0))}, FR ${strongSummary(summaryText(data.fr, 0))}, T ${strongSummary(summaryText(data.temperatura, 1))}°C, SpO2 ${strongSummary(summaryText(data.spo2, 0))}% (FiO2 ${strongSummary(summaryText(fio2, 0))}%).`,
        `GCS ${strongSummary(summaryText(gcs, 0))} (O${strongSummary(summaryText(o, 0))} V${strongSummary(summaryText(v, 0))} M${strongSummary(summaryText(m, 0))}); ${strongSummary(summaryText(data.consciencia))}.`,
        `Sup. Resp: ${strongSummary(summaryRespiratory(data.suporte_ventilatorio_tipo))}. DVA: ${strongSummary(summaryBool(data.vasoativos_em_uso))}.`,
        `Diurese ${strongSummary(summaryText(data.diurese_ml, 0))}mL/${strongSummary(summaryText(data.diurese_horas, 0))}h; IRA ${strongSummary(summaryBool(data.ira_atual))}; TRS ${strongSummary(summaryBool(data.terapia_renal_substitutiva))}.`,
        `Cirrose ${strongSummary(summaryBool(data.cirrose))}; Ascite ${strongSummary(ascite)}.`,
        `LAB: Hb ${strongSummary(summaryText(data.hemoglobina, 1))}, Leuc ${strongSummary(summaryText(data.leucocitos, 1))}, Plaq ${strongSummary(summaryText(data.plaquetas, 0))}, Ur ${strongSummary(summaryText(data.ureia, 1))}, Cr ${strongSummary(summaryText(data.creatinina, 2))}, Na ${strongSummary(summaryText(data.sodio, 1))}, K ${strongSummary(summaryText(data.potassio, 1))}, Glic ${strongSummary(summaryText(data.glicemia, 1))}, BT ${strongSummary(summaryText(data.bilirrubina, 2))}, Alb ${strongSummary(summaryText(data.albumina, 2))}, INR ${strongSummary(summaryText(data.inr, 2))}.`,
        `GASO: pH ${strongSummary(summaryText(data.ph, 2))}, pO2 ${strongSummary(summaryText(data.pao2, 1))}, pCO2 ${strongSummary(summaryText(data.paco2, 1))}, HCO3 ${strongSummary(summaryText(data.hco3, 1))}, BE ${strongSummary(summaryText(data.excesso_base, 1))}, Lactato ${strongSummary(summaryText(data.lactato, 1))}.`,
        `SCORES: IMC ${strongSummary(summaryValue(resultados, 'imc', 1))}, PAM ${strongSummary(summaryValue(resultados, 'pam', 0))}, NEWS2 ${strongSummary(summaryValue(resultados, 'news2', 0))}, SOFA ${strongSummary(summaryValue(resultados, 'sofa-2', 0))}, APACHE II ${strongSummary(summaryValue(resultados, 'apache-ii', 0))}, CKD-EPI ${strongSummary(summaryValue(resultados, 'ckd-epi-2021', 0))}, Child ${strongSummary(summaryValue(resultados, 'child-pugh', 0))}, MELD ${strongSummary(summaryValue(resultados, 'meld-3', 0))}.`,
      ];

      const tokens = orderedAssessmentSummary(resultados);
      target.innerHTML = `${tokens ? `<div class="field-help"><strong>Resumo dos resultados:</strong> ${escapeSummary(tokens)}</div>` : ''}<p>${paragraphs.join(' ')}</p>`;
      target.hidden = false;
    }



  function summaryToken(id: string, resultado: { valor: number; resumo?: string }): string {
    const value = formatNumber(resultado.valor, ['news2', 'apache-ii', 'sofa-2', 'child-pugh', 'meld-3'].includes(id) ? 0 : 1);

    switch (id) {
      case 'pam': return `PAM ${value}`;
      case 'shock-index': return `IC ${formatNumber(resultado.valor, 2)}`;
      case 'news2': return `NEWS2 ${value}`;
      case 'ckd-epi-2021': return `TFGe-EPI ${value}`;
      case 'cockcroft-gault': return `ClCr-CG ${value}`;
      case 'apache-ii': return `APACHE II ${value}`;
      case 'sofa-2': return `SOFA-2 ${value}`;
      case 'child-pugh': return resultado.resumo?.replace('.', ',') ?? `CTP ${value}`;
      case 'meld-3': return `MELD 3.0 ${value}`;
      case 'albi': return resultado.resumo?.replace('.', ',') ?? `ALBI ${value}`;
      default:
        return resultado.resumo ?? `${id} ${value}`;
    }
  }

  function formatClinicalValue(value: unknown): string {
    if (value === true) return 'Sim';
    if (value === false) return 'Não';
    if (typeof value === 'number') return formatNumber(value, Number.isInteger(value) ? 0 : 2);
    if (value === null || value === undefined || value === '') return '—';
    return String(value);
  }

  function toggleVasoactivePanel(form: HTMLFormElement): void {
    const select = form.querySelector<HTMLSelectElement>('#vasoativos-em-uso');
    const panel = form.querySelector<HTMLElement>('#vasoactive-extra');
    if (!select || !panel) return;

    panel.hidden = select.value !== 'true';
  }

  function updateGcsPreview(form: HTMLFormElement): void {
    const preview = form.querySelector<HTMLElement>('#gcs-preview');
    if (!preview) return;

    const ocular = Number(form.querySelector<HTMLSelectElement>('select[name="glasgow_ocular"]')?.value);
    const verbal = Number(form.querySelector<HTMLSelectElement>('select[name="glasgow_verbal"]')?.value);
    const motor = Number(form.querySelector<HTMLSelectElement>('select[name="glasgow_motor"]')?.value);
    const limitado = form.querySelector<HTMLSelectElement>('select[name="glasgow_avaliacao_limitada"]')?.value === 'true';
    const pre = Number(form.querySelector<HTMLInputElement>('input[name="glasgow_pre_sedacao"]')?.value);

    if (limitado && Number.isFinite(pre) && pre >= 3 && pre <= 15) {
      preview.innerHTML = `Glasgow: <strong>${pre}</strong> (pré-sedação/intubação)`;
      return;
    }

    if ([ocular, verbal, motor].every((v) => Number.isFinite(v))) {
      preview.innerHTML = `Glasgow: <strong>${ocular + verbal + motor}</strong>`;
      return;
    }

    preview.innerHTML = 'Glasgow: <strong>—</strong>';
  }

  async function render(
    form: HTMLFormElement,
    results: HTMLElement,
    resultCount: HTMLElement,
    assessmentSummary: HTMLElement,
  ): Promise<void> {
    const data = collectData(form);
    const hasAny = Object.keys(data).length > 0;

    updateGcsPreview(form);

    if (!hasAny) {
      resultCount.textContent = 'Aguardando dados';
      assessmentSummary.hidden = true;
      assessmentSummary.textContent = '';
      results.innerHTML = `
        <div class="empty-state">
          <strong>Comece preenchendo os dados do paciente.</strong>
          <span>Conforme os dados forem informados, as calculadoras compatíveis aparecerão aqui.</span>
        </div>
      `;
      return;
    }

    try {
      const [{ registry }, { calcularDisponiveis }] = await Promise.all([
        import('../../lib/calc-engine/registry'),
        import('../../lib/calc-engine/engine'),
      ]);

      const available = calcularDisponiveis(data, registry);
      const complete = available.filter((item) => item.status === 'ok');
      const incomplete = available.filter((item) => item.status === 'incompleto');
      const errors = available.filter((item) => item.status === 'erro');

      resultCount.textContent =
        `${complete.length} ${complete.length === 1 ? 'calculadora disponível' : 'calculadoras disponíveis'}`;

      const summaryTokens = complete
        .map((item) => item.status === 'ok' ? summaryToken(item.calc.id, item.resultado) : '')
        .filter(Boolean);

      if (summaryTokens.length > 0) {
        assessmentSummary.hidden = false;
        renderAssessmentSummaryPlaceholder(data, complete);
      } else {
        assessmentSummary.hidden = true;
        assessmentSummary.textContent = '';
      }

      results.innerHTML = '';

      if (complete.length > 0) {
        const heading = document.createElement('div');
        heading.className = 'subheading';
        heading.textContent = 'Prontas para calcular';
        results.appendChild(heading);

        complete.forEach(({ calc, resultado }) => {
          const card = document.createElement('article');
          card.className = 'result-card';

          const interpretacao =
            typeof calc.interpretar === 'function'
              ? (() => { try { return calc.interpretar(resultado); } catch { return ''; } })()
              : '';

          const detalhes = resultado.detalhamento ?? [];
          const avisos = resultado.avisos ?? [];

          const detalhesHtml = detalhes.length > 0
            ? `
              <details class="breakdown-details">
                <summary>Ver detalhamento do cálculo</summary>
                <div class="breakdown">
                  ${detalhes.map((item) => `
                    <div class="breakdown-row">
                      <div class="breakdown-label">
                        ${escapeHtml(item.descricao || item.campo)}
                      </div>
                      <div class="breakdown-data">
                        <span class="breakdown-value">
                          ${escapeHtml(formatClinicalValue(item.valor))}
                        </span>
                        ${typeof item.pontos === 'number'
                          ? `<span class="breakdown-points">${item.pontos} pt${item.pontos === 1 ? '' : 's'}</span>`
                          : ''}
                      </div>
                    </div>
                  `).join('')}
                </div>
              </details>
            `
            : '';

          const avisosHtml = avisos.length > 0
            ? `
              <div class="result-warnings">
                <strong>Observações</strong>
                <ul>${avisos.map((a) => `<li>${escapeHtml(a)}</li>`).join('')}</ul>
              </div>
            `
            : '';

          card.innerHTML = `
            <div class="result-main">
              <div>
                <span class="result-category">${escapeHtml(calc.categoria)}</span>
                <h3>${escapeHtml(calc.nome)}</h3>
              </div>
              <div class="result-value">
                ${escapeHtml(formatClinicalValue(resultado.valor))}
                ${resultado.unidade ? `<span class="result-unit">${escapeHtml(resultado.unidade)}</span>` : ''}
              </div>
            </div>
            ${interpretacao ? `<p class="result-interpretation">${escapeHtml(interpretacao)}</p>` : ''}
            ${detalhesHtml}
            ${avisosHtml}
          `;

          results.appendChild(card);
        });
      } else {
        results.innerHTML = `
          <div class="empty-state">
            <strong>Nenhuma calculadora está completa com os dados atuais.</strong>
            <span>Preencha outros campos para habilitar mais cálculos.</span>
          </div>
        `;
      }

      if (incomplete.length > 0) {
        const details = document.createElement('details');
        details.className = 'incomplete-details';

        const summary = document.createElement('summary');
        summary.textContent =
          `${incomplete.length} calculadora${incomplete.length === 1 ? '' : 's'} aguardando dados adicionais`;
        details.appendChild(summary);

        const list = document.createElement('div');
        list.className = 'incomplete-list';

        incomplete.forEach(({ calc, faltando }) => {
          const item = document.createElement('div');
          item.className = 'incomplete-item';
          item.innerHTML = `
            <strong>${escapeHtml(calc.nome)}</strong>
            <span>Faltam: ${escapeHtml(faltando.join(', '))}</span>
          `;
          list.appendChild(item);
        });

        details.appendChild(list);
        results.appendChild(details);
      }

      if (errors.length > 0) {
        const details = document.createElement('details');
        details.className = 'incomplete-details';

        const summary = document.createElement('summary');
        summary.textContent =
          `${errors.length} calculadora${errors.length === 1 ? '' : 's'} com erro`;
        details.appendChild(summary);

        const list = document.createElement('div');
        list.className = 'incomplete-list';

        errors.forEach(({ calc, erro }) => {
          const item = document.createElement('div');
          item.className = 'incomplete-item';
          item.innerHTML = `
            <strong>${escapeHtml(calc.nome)}</strong>
            <span>${escapeHtml(erro)}</span>
          `;
          list.appendChild(item);
        });

        details.appendChild(list);
        results.appendChild(details);
      }
    } catch (error) {
      console.error('[Atlas] Erro ao carregar/executar o motor:', error);
      resultCount.textContent = 'Erro';
      assessmentSummary.hidden = true;
      assessmentSummary.textContent = '';
      results.innerHTML = `
        <div class="error-state">
          <strong>O motor de decisão não pôde ser carregado.</strong>
          <span>Abra o console do navegador para identificar o erro.</span>
        </div>
      `;
    }
  }

  function iniciar(): void {
    if (inicializado) return;

    const form = document.querySelector<HTMLFormElement>('#patient-form');
    const results = document.querySelector<HTMLElement>('#results');
    const resultCount = document.querySelector<HTMLElement>('#result-count');
    const assessmentSummary = document.querySelector<HTMLElement>('#assessment-summary');

    if (!form || !results || !resultCount || !assessmentSummary) return;

    inicializado = true;

    form.addEventListener('input', () => {
      updateGcsPreview(form);
      void render(form, results, resultCount, assessmentSummary);
    });

    form.addEventListener('change', () => {
      toggleVasoactivePanel(form);
      updateGcsPreview(form);
      void render(form, results, resultCount, assessmentSummary);
    });

    toggleVasoactivePanel(form);
    updateGcsPreview(form);
    void render(form, results, resultCount, assessmentSummary);
  }

  document.addEventListener('astro:page-load', iniciar);

  if (document.readyState !== 'loading') {
    queueMicrotask(iniciar);
  } else {
    document.addEventListener('DOMContentLoaded', iniciar, { once: true });
  }
</script>

